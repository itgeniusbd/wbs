@{
    ViewData["Title"] = "Our Work";
}

<section class="page-header" style="background: linear-gradient(135deg, #00a99d 0%, #0077b6 100%); padding: 80px 0;">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center text-white">
                <h1 class="display-4 fw-bold mb-3">Our Work</h1>
                <p class="lead">Making a difference in communities through our programs</p>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <i class="fas fa-heartbeat fa-3x text-danger mb-3"></i>
                        <h4>Health</h4>
                        <p class="text-muted">Improving healthcare access and quality</p>
                        <a href="/our-work/health" class="btn btn-outline-primary">Learn More</a>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <i class="fas fa-graduation-cap fa-3x text-success mb-3"></i>
                        <h4>Education</h4>
                        <p class="text-muted">Quality education for all</p>
                        <a href="/our-work/education" class="btn btn-outline-primary">Learn More</a>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <i class="fas fa-tint fa-3x text-info mb-3"></i>
                        <h4>Water & Sanitation</h4>
                        <p class="text-muted">Clean water for communities</p>
                        <a href="/our-work/water-sanitation" class="btn btn-outline-primary">Learn More</a>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <i class="fas fa-hands-helping fa-3x text-warning mb-3"></i>
                        <h4>Livelihood</h4>
                        <p class="text-muted">Sustainable livelihood opportunities</p>
                        <a href="/our-work/livelihood" class="btn btn-outline-primary">Learn More</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
