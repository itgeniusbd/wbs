@model List<WBS.Web.Models.Appeal>
@using Microsoft.AspNetCore.Localization
@{
    ViewData["Title"] = "Appeals";
    var currentCulture = Context.Features.Get<IRequestCultureFeature>()?.RequestCulture.Culture.TwoLetterISOLanguageName ?? "en";
    bool isBangla = currentCulture == "bn";
}

<div class="page-header bg-primary text-white py-5">
    <div class="container">
        <h1 class="display-4">
            @(isBangla ? "আবেদনসমূহ" : "Appeals")
        </h1>
        <p class="lead">
            @(isBangla ? "আমাদের মানবিক কাজে সহায়তা করুন" : "Support our humanitarian work")
        </p>
    </div>
</div>

<div class="container py-5">
    <div class="row mb-5">
        <div class="col-lg-8 mx-auto text-center">
            <h2 class="mb-3">
                @(isBangla ? "আমাদের আবেদনে সাহায্য করুন" : "Support Our Appeals")
            </h2>
            <p class="text-muted">
                @(isBangla 
                    ? "আপনার উদার দান আমাদের জরুরি পরিস্থিতিতে সাড়া দিতে এবং চলমান প্রকল্পগুলিকে সমর্থন করতে সহায়তা করে যা প্রয়োজনীয় মানুষদের জীবনে সত্যিকারের পরিবর্তন আনে।"
                    : "Your generous donations help us respond to emergencies and support ongoing projects that make a real difference in the lives of those in need.")
            </p>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var appeal in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm hover-lift">
                        @if (!string.IsNullOrEmpty(appeal.FeaturedImage))
                        {
                            <img src="@appeal.FeaturedImage" class="card-img-top" alt="@appeal.Title" style="height: 250px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 250px;">
                                <i class="fas fa-hand-holding-heart fa-4x text-muted"></i>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <div class="mb-2">
                                @if (appeal.IsUrgent)
                                {
                                    <span class="badge bg-danger">@(isBangla ? "জরুরি" : "Urgent")</span>
                                }
                                @if (appeal.IsFeatured)
                                {
                                    <span class="badge bg-warning text-dark">@(isBangla ? "বৈশিষ্ট্যিত" : "Featured")</span>
                                }
                                @if (!appeal.IsActive)
                                {
                                    <span class="badge bg-secondary">@(isBangla ? "বন্ধ" : "Closed")</span>
                                }
                            </div>
                            <h5 class="card-title">
                                @if (isBangla && !string.IsNullOrEmpty(appeal.TitleBn))
                                {
                                    @appeal.TitleBn
                                }
                                else
                                {
                                    @appeal.Title
                                }
                            </h5>
                            <p class="card-text text-muted flex-grow-1">
                                @{
                                    var summary = isBangla && !string.IsNullOrEmpty(appeal.SummaryBn) 
                                        ? appeal.SummaryBn 
                                        : appeal.Summary;
                                }
                                @(summary?.Length > 100 ? summary.Substring(0, 100) + "..." : summary)
                            </p>

                            @if (appeal.TargetAmount.HasValue && appeal.TargetAmount > 0)
                            {
                                <div class="mt-auto">
                                    @{
                                        var progressPercentage = (int)((appeal.RaisedAmount / appeal.TargetAmount.Value) * 100);
                                        var progressClass = progressPercentage >= 100 ? "bg-success" : 
                                                          progressPercentage >= 50 ? "bg-info" : "bg-warning";
                                    }
                                    <div class="progress mb-2" style="height: 10px;">
                                        <div class="progress-bar @progressClass" role="progressbar" 
                                             style="width: @progressPercentage%"
                                             aria-valuenow="@progressPercentage" aria-valuemin="0" aria-valuemax="100">
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-between mb-3">
                                        <div>
                                            <small class="text-muted">@(isBangla ? "সংগৃহীত" : "Raised")</small>
                                            <div class="fw-bold text-success">Tk @appeal.RaisedAmount.ToString("N0")</div>
                                        </div>
                                        <div class="text-end">
                                            <small class="text-muted">@(isBangla ? "লক্ষ্য" : "Target")</small>
                                            <div class="fw-bold text-primary">Tk @appeal.TargetAmount.Value.ToString("N0")</div>
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (appeal.IsActive)
                            {
                                <a href="/donation?appealId=@appeal.Id" class="btn btn-primary w-100">
                                    <i class="fas fa-heart me-1"></i> @(isBangla ? "এখনই দান করুন" : "Donate Now")
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-secondary w-100" disabled>
                                    <i class="fas fa-check me-1"></i> @(isBangla ? "আবেদন বন্ধ" : "Appeal Closed")
                                </button>
                            }

                            @if (!string.IsNullOrEmpty(appeal.Content))
                            {
                                <a href="#" class="btn btn-outline-primary w-100 mt-2" data-bs-toggle="modal" data-bs-target="#appealModal@(appeal.Id)">
                                    <i class="fas fa-info-circle me-1"></i> @(isBangla ? "আরও জানুন" : "Learn More")
                                </a>
                            }
                        </div>
                    </div>
                </div>

                <!-- Modal for full description -->
                <div class="modal fade" id="appealModal@(appeal.Id)" tabindex="-1">
                    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">
                                    @if (isBangla && !string.IsNullOrEmpty(appeal.TitleBn))
                                    {
                                        @appeal.TitleBn
                                    }
                                    else
                                    {
                                        @appeal.Title
                                    }
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                @if (!string.IsNullOrEmpty(appeal.BannerImage))
                                {
                                    <img src="@appeal.BannerImage" class="img-fluid rounded mb-3" alt="@appeal.Title">
                                }
                                else if (!string.IsNullOrEmpty(appeal.FeaturedImage))
                                {
                                    <img src="@appeal.FeaturedImage" class="img-fluid rounded mb-3" alt="@appeal.Title">
                                }
                                <div>
                                    @if (isBangla && !string.IsNullOrEmpty(appeal.ContentBn))
                                    {
                                        @Html.Raw(appeal.ContentBn)
                                    }
                                    else
                                    {
                                        @Html.Raw(appeal.Content)
                                    }
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                    @(isBangla ? "বন্ধ করুন" : "Close")
                                </button>
                                @if (appeal.IsActive)
                                {
                                    <a href="/donation?appealId=@appeal.Id" class="btn btn-primary">
                                        <i class="fas fa-heart me-1"></i> @(isBangla ? "এখনই দান করুন" : "Donate Now")
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-6 mx-auto">
                <div class="card shadow-sm text-center p-5">
                    <i class="fas fa-bullhorn fa-4x text-muted mb-3"></i>
                    <h4>@(isBangla ? "কোনো সক্রিয় আবেদন নেই" : "No Active Appeals")</h4>
                    <p class="text-muted">
                        @(isBangla 
                            ? "বর্তমানে কোনো সক্রিয় আবেদন নেই। দয়া করে পরে আবার দেখুন অথবা আমাদের সাধারণ প্রোগ্রামে সাহায্য করুন।"
                            : "There are currently no active appeals. Please check back later or support our general programs.")
                    </p>
                    <a href="/donation" class="btn btn-primary mt-3">
                        <i class="fas fa-donate me-1"></i> @(isBangla ? "সাধারণ দান করুন" : "Make a General Donation")
                    </a>
                </div>
            </div>
        </div>
    }

    <div class="row mt-5">
        <div class="col-lg-10 mx-auto">
            <div class="card bg-light border-0">
                <div class="card-body p-5 text-center">
                    <h3 class="mb-3">
                        @(isBangla ? "আপনি যা খুঁজছেন তা খুঁজে পাচ্ছেন না?" : "Can't find what you're looking for?")
                    </h3>
                    <p class="text-muted mb-4">
                        @(isBangla 
                            ? "যদি আপনার মনে কোনো নির্দিষ্ট উদ্দেশ্য থাকে অথবা আপনার দান কীভাবে ব্যবহার করা হবে সে সম্পর্কে আরও জানতে চান, তাহলে আমাদের সাথে যোগাযোগ করতে দ্বিধা করবেন না।"
                            : "If you have a specific cause in mind or want to learn more about how your donation will be used, please don't hesitate to contact us.")
                    </p>
                    <a href="/about/contact" class="btn btn-outline-primary me-2">
                        <i class="fas fa-envelope me-1"></i> @(isBangla ? "আমাদের সাথে যোগাযোগ করুন" : "Contact Us")
                    </a>
                    <a href="/donation" class="btn btn-primary">
                        <i class="fas fa-hand-holding-heart me-1"></i> @(isBangla ? "এখনই দান করুন" : "Donate Now")
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-lift {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .hover-lift:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15) !important;
    }
</style>
