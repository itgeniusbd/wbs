@model dynamic

@{
    ViewData["Title"] = Model?.Name ?? "Our Work";
}

<section class="page-header" style="background: linear-gradient(135deg, #00a99d 0%, #0077b6 100%); padding: 80px 0;">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center text-white">
                <h1 class="display-4 fw-bold mb-3">@(Model?.Name ?? ViewData["Title"])</h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb justify-content-center">
                        <li class="breadcrumb-item"><a href="/" class="text-white">Home</a></li>
                        <li class="breadcrumb-item"><a href="/our-work" class="text-white">Our Work</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">@(Model?.Name ?? ViewData["Title"])</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <div class="card shadow-sm">
                    <div class="card-body p-5">
                        <h2 class="mb-4">About @(Model?.Name ?? ViewData["Title"])</h2>
                        <p class="lead">@(Model?.Description ?? "Content coming soon...")</p>
                        
                        @if (!string.IsNullOrEmpty(Model?.DescriptionBn))
                        {
                            <hr class="my-4" />
                            <p class="text-muted bangla-text" style="font-family: 'Noto Sans Bengali', sans-serif;">@Model.DescriptionBn</p>
                        }
                        
                        <div class="mt-5">
                            <h3 class="mb-3">Our Impact</h3>
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <div class="text-center p-3 bg-light rounded">
                                        <h2 class="text-primary mb-0">500+</h2>
                                        <p class="text-muted mb-0">Projects</p>
                                    </div>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <div class="text-center p-3 bg-light rounded">
                                        <h2 class="text-success mb-0">50K+</h2>
                                        <p class="text-muted mb-0">People Helped</p>
                                    </div>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <div class="text-center p-3 bg-light rounded">
                                        <h2 class="text-info mb-0">25+</h2>
                                        <p class="text-muted mb-0">Districts</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="mt-4 text-center">
                            <a href="/donation" class="btn btn-danger btn-lg rounded-pill px-5">
                                <i class="fas fa-heart me-2"></i>Support This Cause
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
