@{
    ViewData["Title"] = "jQuery Test";
}

<!DOCTYPE html>
<html>
<head>
    <title>jQuery Test</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <style>
        body { padding: 20px; }
        .status-box { padding: 15px; margin: 10px 0; border-radius: 5px; }
        .success { background: #d4edda; border: 1px solid #c3e6cb; }
        .error { background: #f8d7da; border: 1px solid #f5c6cb; }
        .warning { background: #fff3cd; border: 1px solid #ffeaa7; }
    </style>
</head>
<body>
    <div class="container">
        <h1>jQuery Test Page</h1>
        
        <div id="status" class="status-box warning">
            <h3>Checking jQuery...</h3>
        </div>
        
        <div class="card mt-3">
            <div class="card-body">
                <h5>Test Results:</h5>
                <ul id="results"></ul>
            </div>
        </div>
        
        <div class="mt-3">
            <button id="testBtn" class="btn btn-primary">Click to Test jQuery</button>
        </div>
        
        <div class="mt-3">
            <h5>Loading sequence:</h5>
            <ol id="loadSequence"></ol>
        </div>
    </div>

    <!-- Load jQuery from CDN -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" 
            onload="logLoad('jQuery 3.7.1')"
            onerror="logError('jQuery')"></script>
    
    <script>
        function logLoad(lib) {
            console.log('? Loaded:', lib);
            var seq = document.getElementById('loadSequence');
            if (seq) {
                var li = document.createElement('li');
                li.textContent = '? ' + lib + ' loaded';
                li.style.color = 'green';
                seq.appendChild(li);
            }
        }
        
        function logError(lib) {
            console.error('? Failed to load:', lib);
            var seq = document.getElementById('loadSequence');
            if (seq) {
                var li = document.createElement('li');
                li.textContent = '? ' + lib + ' FAILED';
                li.style.color = 'red';
                seq.appendChild(li);
            }
        }
    </script>
    
    <!-- Wait for jQuery, then load Validation -->
    <script>
        // Wait for jQuery to load
        var checkJQuery = setInterval(function() {
            if (typeof jQuery !== 'undefined') {
                clearInterval(checkJQuery);
                console.log('jQuery ready, loading validation...');
                
                // Now load validation libraries
                var validationScript = document.createElement('script');
                validationScript.src = 'https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js';
                validationScript.onload = function() {
                    logLoad('jQuery Validation 1.19.5');
                    
                    // Load unobtrusive after validation
                    var unobtrusiveScript = document.createElement('script');
                    unobtrusiveScript.src = 'https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js';
                    unobtrusiveScript.onload = function() {
                        logLoad('Unobtrusive Validation 4.0.0');
                        runTests();
                    };
                    unobtrusiveScript.onerror = function() {
                        logError('Unobtrusive Validation');
                        runTests();
                    };
                    document.head.appendChild(unobtrusiveScript);
                };
                validationScript.onerror = function() {
                    logError('jQuery Validation');
                    runTests();
                };
                document.head.appendChild(validationScript);
            }
        }, 100);
        
        function runTests() {
            var results = document.getElementById('results');
            var status = document.getElementById('status');
            
            function addResult(text, isSuccess) {
                var li = document.createElement('li');
                li.textContent = text;
                li.style.color = isSuccess ? 'green' : 'red';
                li.style.fontWeight = 'bold';
                results.appendChild(li);
            }
            
            // Clear previous results
            results.innerHTML = '';
            
            // Test 1: Check if jQuery is loaded
            if (typeof jQuery !== 'undefined') {
                addResult('? jQuery loaded (version: ' + jQuery.fn.jquery + ')', true);
                status.className = 'status-box success';
                status.innerHTML = '<h3>? jQuery is Working!</h3>';
                
                // Test 2: Check validation
                if (typeof $.validator !== 'undefined') {
                    addResult('? jQuery Validation loaded', true);
                } else {
                    addResult('? jQuery Validation NOT loaded', false);
                }
                
                // Test 3: Check unobtrusive validation
                if (typeof $.validator !== 'undefined' && typeof $.validator.unobtrusive !== 'undefined') {
                    addResult('? Unobtrusive Validation loaded', true);
                } else {
                    addResult('? Unobtrusive Validation NOT loaded', false);
                }
                
                // jQuery test button
                jQuery('#testBtn').on('click', function() {
                    alert('jQuery click event works!');
                    addResult('? jQuery event binding works', true);
                });
                
            } else {
                addResult('? jQuery NOT loaded!', false);
                status.className = 'status-box error';
                status.innerHTML = '<h3>? jQuery Failed to Load!</h3>';
            }
            
            // Add network info
            addResult('Browser: ' + navigator.userAgent.substring(0, 50) + '...', true);
            addResult('Page loaded at: ' + new Date().toLocaleString(), true);
        }
        
        // Fallback if jQuery doesn't load after 5 seconds
        setTimeout(function() {
            if (typeof jQuery === 'undefined') {
                logError('jQuery - Timeout');
                runTests();
            }
        }, 5000);
    </script>
</body>
</html>
