@model WBS.Web.Models.Donation
@using Microsoft.AspNetCore.Localization
@{
    ViewData["Title"] = "Thank You for Your Donation";
    var currentCulture = Context.Features.Get<IRequestCultureFeature>()?.RequestCulture.Culture.TwoLetterISOLanguageName ?? "en";
    bool isBangla = currentCulture == "bn";
}

<section class="thank-you-section py-5 bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <!-- Success Message -->
                <div class="text-center mb-5">
                    <div class="mb-4">
                        <i class="fas fa-check-circle text-success" style="font-size: 100px;"></i>
                    </div>
                    @if (isBangla)
                    {
                        <h1 class="fw-bold text-success">ধন্যবাদ!</h1>
                        <p class="lead text-muted">আপনার দানের অনুরোধ আমরা পেয়েছি।</p>
                    }
                    else
                    {
                        <h1 class="fw-bold text-success">Thank You!</h1>
                        <p class="lead text-muted">Your donation request has been received.</p>
                    }
                </div>

                <!-- Donation Details -->
                <div class="card shadow-lg mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-receipt me-2"></i>
                            @(isBangla ? "দানের বিবরণ" : "Donation Details")
                        </h5>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">@(isBangla ? "দান আইডি:" : "Donation ID:")</dt>
                            <dd class="col-sm-8"><span class="badge bg-secondary">#@Model.Id.ToString("D5")</span></dd>

                            <dt class="col-sm-4">@(isBangla ? "দাতার নাম:" : "Donor:")</dt>
                            <dd class="col-sm-8">@Model.DonorName</dd>

                            <dt class="col-sm-4">@(isBangla ? "পরিমাণ:" : "Amount:")</dt>
                            <dd class="col-sm-8 fw-bold text-success fs-4">Tk @Model.Amount.ToString("N0")</dd>

                            @if (Model.DonationType != null)
                            {
                                <dt class="col-sm-4">@(isBangla ? "দানের ধরন:" : "Type:")</dt>
                                <dd class="col-sm-8">@(isBangla && !string.IsNullOrEmpty(Model.DonationType.NameBn) ? Model.DonationType.NameBn : Model.DonationType.Name)</dd>
                            }

                            <dt class="col-sm-4">@(isBangla ? "পেমেন্ট পদ্ধতি:" : "Payment Method:")</dt>
                            <dd class="col-sm-8">
                                <span class="badge bg-info">@Model.PaymentMethod</span>
                            </dd>

                            <dt class="col-sm-4">@(isBangla ? "তারিখ:" : "Date:")</dt>
                            <dd class="col-sm-8">@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</dd>

                            <dt class="col-sm-4">@(isBangla ? "অবস্থা:" : "Status:")</dt>
                            <dd class="col-sm-8">
                                <span class="badge bg-warning">@(isBangla ? "যাচাইয়ের জন্য অপেক্ষমাণ" : "Pending Verification")</span>
                            </dd>
                        </dl>
                    </div>
                </div>

                <!-- Payment Instructions -->
                <div class="card shadow-lg mb-4 border-danger">
                    <div class="card-header bg-danger text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-info-circle me-2"></i>
                            @(isBangla ? "পেমেন্ট নির্দেশনা" : "Payment Instructions")
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (Model.PaymentMethod == "bKash")
                        {
                            <div class="alert alert-info">
                                <h6 class="fw-bold">
                                    <i class="fas fa-mobile-alt me-2"></i>
                                    @(isBangla ? "bKash এ পেমেন্ট করুন" : "Pay with bKash")
                                </h6>
                                @if (isBangla)
                                {
                                    <p class="mb-2"><strong>১. bKash অ্যাপ খুলুন</strong></p>
                                    <p class="mb-2"><strong>২. "Send Money" সিলেক্ট করুন</strong></p>
                                    <p class="mb-2"><strong>৩. আমাদের নম্বরে টাকা পাঠান:</strong></p>
                                }
                                else
                                {
                                    <p class="mb-2"><strong>1. Open bKash app</strong></p>
                                    <p class="mb-2"><strong>2. Select "Send Money"</strong></p>
                                    <p class="mb-2"><strong>3. Send money to our number:</strong></p>
                                }
                                <div class="bg-white p-3 rounded border text-center">
                                    <h4 class="text-danger mb-0">01700-000000</h4>
                                    <small class="text-muted">@(isBangla ? "(Personal)" : "(Personal)")</small>
                                </div>
                                <p class="mt-3 mb-1">
                                    <strong>@(isBangla ? "পরিমাণ:" : "Amount:")</strong> 
                                    <span class="text-success fs-5">Tk @Model.Amount.ToString("N0")</span>
                                </p>
                                <p class="mb-0">
                                    <strong>@(isBangla ? "রেফারেন্স:" : "Reference:")</strong> 
                                    <span class="badge bg-secondary">#@Model.Id.ToString("D5")</span>
                                </p>
                            </div>
                        }
                        else if (Model.PaymentMethod == "Nagad")
                        {
                            <div class="alert alert-warning">
                                <h6 class="fw-bold">
                                    <i class="fas fa-mobile-alt me-2"></i>
                                    @(isBangla ? "Nagad এ পেমেন্ট করুন" : "Pay with Nagad")
                                </h6>
                                @if (isBangla)
                                {
                                    <p class="mb-2"><strong>১. Nagad অ্যাপ খুলুন</strong></p>
                                    <p class="mb-2"><strong>২. "Send Money" সিলেক্ট করুন</strong></p>
                                    <p class="mb-2"><strong>৩. আমাদের নম্বরে টাকা পাঠান:</strong></p>
                                }
                                else
                                {
                                    <p class="mb-2"><strong>1. Open Nagad app</strong></p>
                                    <p class="mb-2"><strong>2. Select "Send Money"</strong></p>
                                    <p class="mb-2"><strong>3. Send money to our number:</strong></p>
                                }
                                <div class="bg-white p-3 rounded border text-center">
                                    <h4 class="text-warning mb-0">01800-000000</h4>
                                    <small class="text-muted">@(isBangla ? "(Personal)" : "(Personal)")</small>
                                </div>
                                <p class="mt-3 mb-1">
                                    <strong>@(isBangla ? "পরিমাণ:" : "Amount:")</strong> 
                                    <span class="text-success fs-5">Tk @Model.Amount.ToString("N0")</span>
                                </p>
                                <p class="mb-0">
                                    <strong>@(isBangla ? "রেফারেন্স:" : "Reference:")</strong> 
                                    <span class="badge bg-secondary">#@Model.Id.ToString("D5")</span>
                                </p>
                            </div>
                        }
                        else if (Model.PaymentMethod == "Bank")
                        {
                            <div class="alert alert-primary">
                                <h6 class="fw-bold">
                                    <i class="fas fa-university me-2"></i>
                                    @(isBangla ? "ব্যাংক ট্রান্সফার" : "Bank Transfer")
                                </h6>
                                @if (isBangla)
                                {
                                    <p><strong>আমাদের ব্যাংক একাউন্টে টাকা পাঠান:</strong></p>
                                }
                                else
                                {
                                    <p><strong>Transfer to our bank account:</strong></p>
                                }
                                <div class="bg-white p-3 rounded border">
                                    <p class="mb-1"><strong>@(isBangla ? "ব্যাংকের নাম:" : "Bank Name:")</strong> Dutch Bangla Bank Ltd.</p>
                                    <p class="mb-1"><strong>@(isBangla ? "একাউন্ট নাম:" : "Account Name:")</strong> WBS Foundation</p>
                                    <p class="mb-1"><strong>@(isBangla ? "একাউন্ট নম্বর:" : "Account Number:")</strong> 123-456-789012</p>
                                    <p class="mb-1"><strong>@(isBangla ? "শাখা:" : "Branch:")</strong> Gulshan, Dhaka</p>
                                    <p class="mb-0"><strong>@(isBangla ? "রাউটিং নম্বর:" : "Routing Number:")</strong> 090271724</p>
                                </div>
                                <p class="mt-3 mb-1">
                                    <strong>@(isBangla ? "পরিমাণ:" : "Amount:")</strong> 
                                    <span class="text-success fs-5">Tk @Model.Amount.ToString("N0")</span>
                                </p>
                                <p class="mb-0">
                                    <strong>@(isBangla ? "রেফারেন্স:" : "Reference:")</strong> 
                                    <span class="badge bg-secondary">#@Model.Id.ToString("D5")</span>
                                </p>
                            </div>
                        }

                        <div class="alert alert-warning mt-3 mb-0">
                            <h6 class="fw-bold">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                @(isBangla ? "গুরুত্বপূর্ণ নির্দেশনা" : "Important Instructions")
                            </h6>
                            @if (isBangla)
                            {
                                <ul class="mb-0 small">
                                    <li>পেমেন্ট করার পর <strong>Transaction ID</strong> সংরক্ষণ করুন</li>
                                    <li>আমাদের সাথে যোগাযোগ করে আপনার Transaction ID শেয়ার করুন</li>
                                    <li>ফোন: <strong>+880 1700-000000</strong></li>
                                    <li>ইমেইল: <strong>donation@wbs.org</strong></li>
                                    <li>যাচাইয়ের পর আপনি রশিদ পাবেন</li>
                                </ul>
                            }
                            else
                            {
                                <ul class="mb-0 small">
                                    <li>After payment, please <strong>save Transaction ID</strong></li>
                                    <li>Contact us and share your Transaction ID</li>
                                    <li>Phone: <strong>+880 1700-000000</strong></li>
                                    <li>Email: <strong>donation@wbs.org</strong></li>
                                    <li>You will receive receipt after verification</li>
                                </ul>
                            }
                        </div>
                    </div>
                </div>

                <!-- Confirmation -->
                <div class="text-center">
                    <p class="text-muted">
                        @if (isBangla)
                        {
                            <text>একটি নিশ্চিতকরণ ইমেইল পাঠানো হয়েছে</text>
                        }
                        else
                        {
                            <text>A confirmation email has been sent to</text>
                        }
                        <strong>@Model.Email</strong>
                    </p>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-center mt-4">
                    <a href="/" class="btn btn-primary btn-lg px-5">
                        <i class="fas fa-home me-2"></i>
                        @(isBangla ? "হোমে ফিরুন" : "Back to Home")
                    </a>
                    <a href="/donation" class="btn btn-outline-danger btn-lg px-5">
                        <i class="fas fa-heart me-2"></i>
                        @(isBangla ? "আবার দান করুন" : "Donate Again")
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
