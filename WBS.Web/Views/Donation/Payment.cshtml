                                </div>
                                <button type="submit" class="btn btn-danger btn-lg w-100">
                                    <i class="fas fa-check-circle me-2"></i>
                                    @(isBangla ? "??????? ??????? ????" : "Confirm Payment")
                                </button>
                            </form>
