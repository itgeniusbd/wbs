                                        ? "??????: <strong>?" + Model.Amount.ToString("N0") + "</strong>" 
                                        : "Amount: <strong>?" + Model.Amount.ToString("N0") + "</strong>")
                                </li>
                                <li class="mb-3">
                                    @(isBangla 
                                        ? "????????? ?????? ????? ??? ?????: <strong>" + Model.DonorName + "</strong>" 
                                        : "Enter your name as reference: <strong>" + Model.DonorName + "</strong>")
                                </li>
                                <li class="mb-3">
                                    @(isBangla 
                                        ? "??????? ??????? ???? ??? Transaction ID ??????? ????" 
                                        : "Complete the payment and save the Transaction ID")
                                </li>
                            </ol>

