@model WBS.Web.Models.Donation
@using Microsoft.AspNetCore.Localization
@{
    ViewData["Title"] = "Payment Information";
    var currentCulture = Context.Features.Get<IRequestCultureFeature>()?.RequestCulture.Culture.TwoLetterISOLanguageName ?? "en";
    bool isBangla = currentCulture == "bn";
}

<section class="page-header bg-primary text-white py-5">
    <div class="container">
        <h1 class="fw-bold">@(isBangla ? "??????? ????" : "Payment Information")</h1>
        <p class="lead mb-0">@(isBangla ? "????? ????? ???? ???????" : "Thank you for your generous donation")</p>
    </div>
</section>

<section class="payment-info py-5">
    <div class="container">
        <div class="row">
            <!-- Donation Summary -->
            <div class="col-lg-4 mb-4">
                <div class="card shadow sticky-top" style="top: 20px;">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-file-invoice me-2"></i>
                            @(isBangla ? "??? ??????????" : "Donation Summary")
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>@(isBangla ? "??????" : "Amount"):</span>
                            <strong class="text-primary fs-4">?@Model.Amount.ToString("N0")</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>@(isBangla ? "???" : "Type"):</span>
                            <span>@Model.DonationType?.Name</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>@(isBangla ? "????? ???" : "Donor"):</span>
                            <span>@Model.DonorName</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>@(isBangla ? "?????" : "Email"):</span>
                            <span class="small">@Model.Email</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Phone))
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span>@(isBangla ? "???" : "Phone"):</span>
                                <span>@Model.Phone</span>
                            </div>
                        }
                        <hr />
                        <div class="d-flex justify-content-between">
                            <strong>@(isBangla ? "??????? ??????" : "Payment Method"):</strong>
                            <span class="badge bg-info">@Model.PaymentMethod</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Payment Instructions -->
            <div class="col-lg-8">
                @if (Model.PaymentMethod == "bKash")
                {
                    <div class="card shadow mb-4">
                        <div class="card-header bg-danger text-white">
                            <h4 class="mb-0">
                                <i class="fas fa-mobile-alt me-2"></i>
                                @(isBangla ? "????? ???????" : "bKash Payment")
                            </h4>
                        </div>
                        <div class="card-body p-4">
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle me-2"></i>
                                @(isBangla 
                                    ? "????? ????????? ?????? ??? ??????? ??????? ????" 
                                    : "Please follow the instructions below to complete your payment")
                            </div>

                            <h5 class="fw-bold mb-3">@(isBangla ? "??????? ???????:" : "Payment Steps:")</h5>
                            <ol class="payment-steps">
                                <li class="mb-3">
                                    @(isBangla 
                                        ? "????? ????? ????? ????? ??? \"????? ????\" ???????? ????" 
                                        : "Open your bKash app and select \"Send Money\"")
                                </li>
                                <li class="mb-3">
                                    @(isBangla ? "????? ?????? ???? ?????:" : "Send money to the following number:")
