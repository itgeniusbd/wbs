                                        <tr>
                                            <td class="fw-bold">@(isBangla ? "?????? ???:" : "Bank Name:")</td>
                                            <td id="bankName2">Islami Bank Bangladesh Limited</td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-primary" onclick="copyToClipboard('bankName2')">
                                                    <i class="fas fa-copy"></i>
