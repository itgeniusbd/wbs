                            <h5 class="fw-bold mb-3">@(isBangla ? "??????? ??????????:" : "Payment Confirmation:")</h5>
                            <form asp-action="ConfirmPayment" method="post">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <div class="mb-3">
                                    <label class="form-label">@(isBangla ? "Transaction/Reference ID" : "Transaction/Reference ID")</label>
                                    <input type="text" name="transactionId" class="form-control form-control-lg" 
                                           placeholder="@(isBangla ? "?????? Transaction ID ?????" : "Enter Bank Transaction ID")" required />
