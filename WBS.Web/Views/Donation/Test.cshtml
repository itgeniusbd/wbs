@{
    ViewData["Title"] = "Test Donation";
    Layout = "~/Views/Shared/_LayoutSimple.cshtml";
}

<div class="container py-5">
    <div class="alert alert-success">
        <h1><i class="fas fa-check-circle"></i> Success!</h1>
        <p class="mb-0">If you can see this page, the application is working!</p>
    </div>
    
    <div class="card mt-4">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Diagnostic Information</h3>
        </div>
        <div class="card-body">
            <ul class="list-group">
                <li class="list-group-item">
                    <strong>Application:</strong> Running ?
                </li>
                <li class="list-group-item">
                    <strong>Routing:</strong> Working ?
                </li>
                <li class="list-group-item">
                    <strong>DonationController:</strong> Responding ?
                </li>
                <li class="list-group-item">
                    <strong>Layout:</strong> Simple Layout (No Database Calls) ?
                </li>
            </ul>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header bg-warning">
            <h3 class="mb-0">Test Links</h3>
        </div>
        <div class="card-body">
            <div class="d-grid gap-2">
                <a href="/" class="btn btn-primary btn-lg">
                    <i class="fas fa-home me-2"></i>Go to Home (May Crash)
                </a>
                <a href="/donation" class="btn btn-danger btn-lg">
                    <i class="fas fa-heart me-2"></i>Try Full Donation Page (May Crash)
                </a>
                <a href="/account/login" class="btn btn-success btn-lg">
                    <i class="fas fa-sign-in-alt me-2"></i>Login Page
                </a>
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header bg-info text-white">
            <h3 class="mb-0">Problem Analysis</h3>
        </div>
        <div class="card-body">
            <h5>StackOverflowException Causes:</h5>
            <ol>
                <li><strong>_Layout.cshtml</strong> - Calling services on every page load</li>
                <li><strong>MenuService</strong> - May have circular reference</li>
                <li><strong>ContentService</strong> - May be calling itself recursively</li>
                <li><strong>Program.cs</strong> - Seeding code causing issues</li>
            </ol>

            <h5 class="mt-3">Solutions Applied:</h5>
            <ul class="list-group">
                <li class="list-group-item list-group-item-success">
                    <i class="fas fa-check me-2"></i>Disabled seeding code in Program.cs
                </li>
                <li class="list-group-item list-group-item-success">
                    <i class="fas fa-check me-2"></i>Created simple layout without service calls
                </li>
                <li class="list-group-item list-group-item-success">
                    <i class="fas fa-check me-2"></i>Added error handling to DonationController
                </li>
            </ul>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">Next Steps</h3>
        </div>
        <div class="card-body">
            <ol>
                <li>Verify this test page loads successfully</li>
                <li>Check database connection</li>
                <li>Add caching to _Layout.cshtml</li>
                <li>Fix MenuService and ContentService</li>
                <li>Re-enable seeding code</li>
            </ol>
        </div>
    </div>
</div>
