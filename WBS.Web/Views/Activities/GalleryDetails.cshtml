@model WBS.Web.Models.Gallery
@using Microsoft.AspNetCore.Localization
@{
    ViewData["Title"] = Model.Title;
    var currentCulture = Context.Features.Get<IRequestCultureFeature>()?.RequestCulture.Culture.TwoLetterISOLanguageName ?? "en";
    bool isBangla = currentCulture == "bn";
}

<section class="page-header" style="background: linear-gradient(135deg, #00a99d 0%, #0077b6 100%); padding: 80px 0;">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center text-white">
                <h1 class="display-4 fw-bold mb-3">
                    @if (isBangla && !string.IsNullOrEmpty(Model.TitleBn))
                    {
                        @Model.TitleBn
                    }
                    else
                    {
                        @Model.Title
                    }
                </h1>
                @if (!string.IsNullOrEmpty(Model.Description) || !string.IsNullOrEmpty(Model.DescriptionBn))
                {
                    <p class="lead">
                        @if (isBangla && !string.IsNullOrEmpty(Model.DescriptionBn))
                        {
                            @Model.DescriptionBn
                        }
                        else
                        {
                            @Model.Description
                        }
                    </p>
                }
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <!-- Back Button -->
        <div class="mb-4">
            <a href="/activities/gallery" class="btn btn-outline-primary">
                <i class="fas fa-arrow-left me-2"></i>
                @(isBangla ? "?? ????????" : "Back to Galleries")
            </a>
        </div>

        <!-- Gallery Info -->
        @if (!string.IsNullOrEmpty(Model.Description) || !string.IsNullOrEmpty(Model.DescriptionBn))
        {
            <div class="row mb-4">
                <div class="col-lg-8 mx-auto">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <p class="mb-0">
                                @if (isBangla && !string.IsNullOrEmpty(Model.DescriptionBn))
                                {
                                    @Model.DescriptionBn
                                }
                                else
                                {
                                    @Model.Description
                                }
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Gallery Images -->
        @if (Model.Images != null && Model.Images.Any())
        {
            <div class="row g-4">
                @foreach (var image in Model.Images.OrderBy(i => i.DisplayOrder))
                {
                    <div class="col-md-4 col-sm-6">
                        <div class="card h-100 border-0 shadow-sm gallery-item">
                            <a href="@image.ImageUrl" data-lightbox="gallery" data-title="@(isBangla && !string.IsNullOrEmpty(image.CaptionBn) ? image.CaptionBn : image.Caption)">
                                <img src="@image.ImageUrl" 
                                     class="card-img-top gallery-image" 
                                     alt="@(isBangla && !string.IsNullOrEmpty(image.CaptionBn) ? image.CaptionBn : image.Caption)" 
                                     style="height: 250px; object-fit: cover; cursor: pointer;" />
                            </a>
                            @if (!string.IsNullOrEmpty(image.Caption) || !string.IsNullOrEmpty(image.CaptionBn))
                            {
                                <div class="card-body">
                                    <p class="card-text text-muted mb-0">
                                        @if (isBangla && !string.IsNullOrEmpty(image.CaptionBn))
                                        {
                                            @image.CaptionBn
                                        }
                                        else
                                        {
                                            @image.Caption
                                        }
                                    </p>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Gallery Stats -->
            <div class="row mt-5">
                <div class="col-lg-6 mx-auto">
                    <div class="card border-0 shadow-sm bg-light">
                        <div class="card-body text-center">
                            <h5 class="mb-3">
                                <i class="fas fa-images text-primary me-2"></i>
                                @(isBangla ? "???????? ????" : "Gallery Information")
                            </h5>
                            <div class="row">
                                <div class="col-6">
                                    <div class="border-end">
                                        <h3 class="text-primary mb-0">@Model.Images.Count</h3>
                                        <small class="text-muted">@(isBangla ? "???" : "Photos")</small>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <h3 class="text-primary mb-0">@Model.CreatedAt.ToString("MMM yyyy")</h3>
                                    <small class="text-muted">@(isBangla ? "???? ??? ??????" : "Created")</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info text-center">
                <i class="fas fa-info-circle fa-2x mb-3 d-block"></i>
                <h5>@(isBangla ? "???? ??? ?????? ??????" : "No photos available")</h5>
                <p class="mb-0">@(isBangla ? "?? ?????????? ???? ???? ??? ????? ??? ??????" : "No photos have been added to this gallery yet.")</p>
            </div>
        }
    </div>
</section>

<!-- Lightbox CSS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.3/css/lightbox.min.css" />

<style>
    .gallery-item {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .gallery-item:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.15) !important;
    }
    
    .gallery-image {
        transition: opacity 0.3s ease;
    }
    
    .gallery-image:hover {
        opacity: 0.9;
    }
</style>

@section Scripts {
    <!-- Lightbox JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.3/js/lightbox.min.js"></script>
    <script>
        lightbox.option({
            'resizeDuration': 200,
            'wrapAround': true,
            'albumLabel': '@(isBangla ? "??? %1 ?? %2" : "Image %1 of %2")'
        });
    </script>
}
