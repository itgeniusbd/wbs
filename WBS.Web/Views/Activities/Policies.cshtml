@model IEnumerable<WBS.Web.Models.Policy>
@using WBS.Web.Helpers
@{
    ViewData["Title"] = "Policies";
}

<section class="page-header" style="background: linear-gradient(135deg, #00a99d 0%, #0077b6 100%); padding: 80px 0;">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center text-white">
                <h1 class="display-4 fw-bold mb-3">@(LanguageHelper.IsEnglish(Context) ? "Policies & Guidelines" : "নীতি ও নির্দেশিকা")</h1>
                <p class="lead">@(LanguageHelper.IsEnglish(Context) ? "Our organizational policies and operational guidelines" : "আমাদের সাংগঠনিক নীতি এবং পরিচালনা নির্দেশিকা")</p>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                @if (Model != null && Model.Any())
                {
                    @foreach (var policy in Model)
                    {
                        <div class="card shadow-sm mb-4">
                            <div class="card-header bg-primary text-white">
                                <h5 class="mb-0">
                                    <i class="@policy.Icon me-2"></i>
                                    @(LanguageHelper.IsEnglish(Context) ? policy.Title : (policy.TitleBn ?? policy.Title))
                                </h5>
                            </div>
                            <div class="card-body">
                                <p>@(LanguageHelper.IsEnglish(Context) ? policy.Description : (policy.DescriptionBn ?? policy.Description))</p>
                                @if (!string.IsNullOrEmpty(policy.PdfUrl))
                                {
                                    <div class="d-flex gap-2">
                                        <a href="@Url.Action("ViewPDF", "Policies", new { area = "Admin", id = policy.Id })" target="_blank" class="btn btn-outline-primary">
                                            <i class="fas fa-eye me-2"></i>@(LanguageHelper.IsEnglish(Context) ? "View" : "দেখুন")
                                        </a>
                                        <a href="@Url.Action("DownloadPDF", "Policies", new { area = "Admin", id = policy.Id })" class="btn btn-primary">
                                            <i class="fas fa-download me-2"></i>@(LanguageHelper.IsEnglish(Context) ? "Download" : "ডাউনলোড করুন")
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="card shadow-sm mb-4">
                        <div class="card-body text-center py-5">
                            <i class="fas fa-file-alt fa-3x text-muted mb-3"></i>
                            <p class="text-muted">@(LanguageHelper.IsEnglish(Context) ? "No policies available at this time." : "এই মুহূর্তে কোনও নীতিমালা উপলব্ধ নেই।")</p>
                        </div>
                    </div>
                }

                <div class="alert alert-info mt-4">
                    <i class="fas fa-info-circle me-2"></i>
                    @if (LanguageHelper.IsEnglish(Context))
                    {
                        <text>For more information about our policies or to request additional documents, please <a href="/about/contact" class="alert-link">contact us</a>.</text>
                    }
                    else
                    {
                        <text>আমাদের নীতিমালা সম্পর্কে আরও তথ্যের জন্য অথবা অতিরিক্ত নথির অনুরোধ করতে, অনুগ্রহ করে <a href="/about/contact" class="alert-link">যোগাযোগ করুন</a>?</text>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
