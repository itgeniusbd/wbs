@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Localization
@using WBS.Web.Services
@inject SignInManager<WBS.Web.Models.ApplicationUser> SignInManager
@inject IContentService ContentService
@inject IMenuService MenuService
@{
    var currentCulture = Context.Features.Get<IRequestCultureFeature>()?.RequestCulture.Culture.TwoLetterISOLanguageName ?? "en";
    bool isBangla = currentCulture == "bn";
    var siteSettings = await ContentService.GetSiteSettingsAsync();
    var menus = await MenuService.GetActiveMenusAsync(currentCulture);
}
<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @(siteSettings?.SiteName ?? "WBS")</title>
    @if (!string.IsNullOrEmpty(siteSettings?.Favicon))
    {
        <link rel="icon" type="image/x-icon" href="@siteSettings.Favicon" />
    }
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body[lang="bn"], body[lang="bn"] * {
            font-family: 'Noto Sans Bengali', 'SolaimanLipi', 'Kalpurush', Arial, sans-serif !important;
        }
        .search-container {
            position: relative;
        }
        .search-box {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100vh;
            background: rgba(0, 0, 0, 0.95);
            z-index: 9999;
            display: none;
            justify-content: center;
            align-items: center;
        }
        .search-box.active {
            display: flex;
        }
        .search-box-content {
            width: 90%;
            max-width: 800px;
            position: relative;
        }
        .search-box input {
            width: 100%;
            padding: 20px 60px 20px 20px;
            font-size: 1.5rem;
            border: 2px solid #fff;
            background: transparent;
            color: #fff;
            border-radius: 50px;
        }
        .search-box input::placeholder {
            color: rgba(255, 255, 255, 0.7);
        }
        .search-box input:focus {
            outline: none;
            border-color: #00a99d;
        }
        .search-box-close {
            position: absolute;
            top: -60px;
            right: 0;
            background: none;
            border: none;
            color: #fff;
            font-size: 2.5rem;
            cursor: pointer;
            transition: transform 0.3s ease;
        }
        .search-box-close:hover {
            transform: rotate(90deg);
        }
        .search-btn-submit {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            background: #00a99d;
            border: none;
            color: #fff;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            cursor: pointer;
            transition: background 0.3s ease;
        }
        .search-btn-submit:hover {
            background: #008c82;
        }
    </style>
</head>
<body>
    <!-- Search Box Overlay -->
    <div class="search-box" id="searchBox">
        <div class="search-box-content">
            <button type="button" class="search-box-close" onclick="toggleSearch()">
                <i class="fas fa-times"></i>
            </button>
            <form action="/search" method="get">
                <div style="position: relative;">
                    <input type="text" name="q" placeholder="@(isBangla ? "এখানে সার্চ করুন..." : "Search here...")" autofocus />
                    <button type="submit" class="search-btn-submit">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Main Navigation -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand" href="/">
                @if (!string.IsNullOrEmpty(siteSettings?.Logo))
                {
                    <img src="@siteSettings.Logo" alt="@(siteSettings?.SiteName ?? "WBS")" style="height: 40px;" />
                }
                else
                {
                    <span class="fw-bold text-primary fs-4">@(siteSettings?.SiteName ?? "WBS")</span>
                }
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">
                            <i class="fas fa-home me-1"></i>@(isBangla ? "হোম" : "Home")
                        </a>
                    </li>
                    @foreach (var menu in menus)
                    {
                        if (menu.SubMenus.Any())
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    @if (!string.IsNullOrEmpty(menu.Icon))
                                    {
                                        <i class="@menu.Icon me-1"></i>
                                    }
                                    @menu.Name
                                </a>
                                <ul class="dropdown-menu">
                                    @foreach (var submenu in menu.SubMenus)
                                    {
                                        var submenuUrl = submenu.Url ?? "#";
                                        if (!string.IsNullOrEmpty(submenuUrl) && !submenuUrl.StartsWith("/") && !submenuUrl.StartsWith("http"))
                                        {
                                            submenuUrl = "/" + submenuUrl;
                                        }
                                        <li>
                                            <a class="dropdown-item" href="@submenuUrl" @(submenu.IsExternal ? "target='_blank'" : "")>
                                                @if (!string.IsNullOrEmpty(submenu.Icon))
                                                {
                                                    <i class="@submenu.Icon me-2"></i>
                                                }
                                                @submenu.Name
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }
                        else
                        {
                            var menuUrl = menu.Url ?? "#";
                            if (!string.IsNullOrEmpty(menuUrl) && !menuUrl.StartsWith("/") && !menuUrl.StartsWith("http"))
                            {
                                menuUrl = "/" + menuUrl;
                            }
                            <li class="nav-item">
                                <a class="nav-link" href="@menuUrl" @(menu.IsExternal ? "target='_blank'" : "")>
                                    @if (!string.IsNullOrEmpty(menu.Icon))
                                    {
                                        <i class="@menu.Icon me-1"></i>
                                    }
                                    @menu.Name
                                </a>
                            </li>
                        }
                    }
                    
                    <li class="nav-item">
                        <button type="button" class="btn btn-link nav-link" onclick="toggleSearch()" title="@(isBangla ? "সার্চ" : "Search")">
                            <i class="fas fa-search"></i>
                        </button>
                    </li>
                    
                    <li class="nav-item">
                        <div class="language-switcher-custom d-flex align-items-center mt-2 mt-lg-0">
                            <form asp-controller="Language" asp-action="SetLanguage" method="post" class="d-inline">
                                <input type="hidden" name="culture" value="bn" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                <button type="submit" class="btn-lang @(currentCulture == "bn" ? "active" : "")">
                                    বাং
                                </button>
                            </form>
                            <form asp-controller="Language" asp-action="SetLanguage" method="post" class="d-inline">
                                <input type="hidden" name="culture" value="en" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                <button type="submit" class="btn-lang @(currentCulture == "en" ? "active" : "")">
                                    EN
                                </button>
                            </form>
                        </div>
                    </li>
                    
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item">
                            <a class="btn btn-warning rounded-circle ms-2" href="/Admin/Dashboard" title="@User.Identity?.Name" style="width: 40px; height: 40px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                                <i class="fas fa-user"></i>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-success rounded ms-2" href="/donation" style="padding: 0.5rem 1.5rem;">
                                @(isBangla ? "দান করুন" : "Donate")
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-warning rounded-circle ms-2" href="/Account/Login" title="@(isBangla ? "লগইন" : "Login")" style="width: 40px; height: 40px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                                <i class="fas fa-user"></i>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-success rounded ms-2" href="/donation" style="padding: 0.5rem 1.5rem;">
                                @(isBangla ? "দান করুন" : "Donate")
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-light pt-5 pb-3">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 mb-4">
                    <h5 class="text-white mb-3">
                        @if (!string.IsNullOrEmpty(siteSettings?.LogoWhite))
                        {
                            <img src="@siteSettings.LogoWhite" alt="@(siteSettings?.SiteName ?? "WBS")" style="height: 35px;" />
                        }
                        else
                        {
                            @(siteSettings?.SiteName ?? "WBS")
                        }
                    </h5>
                    <p class="text-white-50">
                        @if (!string.IsNullOrEmpty(siteSettings?.FooterText))
                        {
                            if (isBangla && !string.IsNullOrEmpty(siteSettings?.FooterTextBn))
                            {
                                @siteSettings.FooterTextBn
                            }
                            else
                            {
                                @siteSettings.FooterText
                            }
                        }
                        else
                        {
                            var displayName = (isBangla && !string.IsNullOrEmpty(siteSettings?.SiteNameBn)) 
                                ? siteSettings.SiteNameBn 
                                : (siteSettings?.SiteName ?? "Working Bangladesh Society");
                            var tagline = isBangla 
                                ? "বাংলাদেশজুড়ে সম্প্রদায়ে পরিবর্তন আনছি।" 
                                : "Making a difference in communities across Bangladesh.";
                            @displayName <text> - </text> @tagline
                        }
                    </p>
                    <div class="social-links mt-3">
                        @if (!string.IsNullOrEmpty(siteSettings?.FacebookUrl))
                        {
                            <a href="@siteSettings.FacebookUrl" target="_blank" class="btn btn-outline-light btn-sm me-2"><i class="fab fa-facebook-f"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(siteSettings?.TwitterUrl))
                        {
                            <a href="@siteSettings.TwitterUrl" target="_blank" class="btn btn-outline-light btn-sm me-2"><i class="fab fa-twitter"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(siteSettings?.InstagramUrl))
                        {
                            <a href="@siteSettings.InstagramUrl" target="_blank" class="btn btn-outline-light btn-sm me-2"><i class="fab fa-instagram"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(siteSettings?.YouTubeUrl))
                        {
                            <a href="@siteSettings.YouTubeUrl" target="_blank" class="btn btn-outline-light btn-sm"><i class="fab fa-youtube"></i></a>
                        }
                    </div>
                </div>
                <div class="col-lg-2 col-md-4 mb-4">
                    <h5 class="text-white mb-3">@(isBangla ? "দ্রুত লিংক" : "Quick Links")</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="/about/whoweare" class="text-white-50 text-decoration-none hover-link">@(isBangla ? "আমাদের সম্পর্কে" : "About Us")</a></li>
                        <li class="mb-2"><a href="/ourwork" class="text-white-50 text-decoration-none hover-link">@(isBangla ? "আমাদের কাজ" : "Our Work")</a></li>
                        <li class="mb-2"><a href="/appeals" class="text-white-50 text-decoration-none hover-link">@(isBangla ? "আবেদন" : "Appeals")</a></li>
                        <li class="mb-2"><a href="/news" class="text-white-50 text-decoration-none hover-link">@(isBangla ? "খবর" : "News")</a></li>
                        <li class="mb-2"><a href="/about/contact" class="text-white-50 text-decoration-none hover-link">@(isBangla ? "যোগাযোগ" : "Contact")</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-4 mb-4">
                    <h5 class="text-white mb-3">@(isBangla ? "যুক্ত হন" : "Get Involved")</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="/donation" class="text-white-50 text-decoration-none hover-link">@(isBangla ? "দান করুন" : "Donate")</a></li>
                        <li class="mb-2"><a href="/getinvolved/volunteer" class="text-white-50 text-decoration-none hover-link">@(isBangla ? "স্বেচ্ছাসেবক" : "Volunteer")</a></li>
                        <li class="mb-2"><a href="/getinvolved/events" class="text-white-50 text-decoration-none hover-link">@(isBangla ? "ইভেন্ট" : "Events")</a></li>
                        <li class="mb-2"><a href="/getinvolved/career" class="text-white-50 text-decoration-none hover-link">@(isBangla ? "ক্যারিয়ার" : "Career")</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-4 mb-4">
                    <h5 class="text-white mb-3">@(isBangla ? "নীতি" : "Policies")</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="/page/privacy-policy" class="text-white-50 text-decoration-none hover-link">@(isBangla ? "গোপনীয়তা নীতি" : "Privacy Policy")</a></li>
                        <li class="mb-2"><a href="/page/terms-conditions" class="text-white-50 text-decoration-none hover-link">@(isBangla ? "শর্তাবলী" : "Terms & Conditions")</a></li>
                        <li class="mb-2"><a href="/page/refund-policy" class="text-white-50 text-decoration-none hover-link">@(isBangla ? "রিফান্ড নীতি" : "Refund Policy")</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-4 mb-4">
                    <h5 class="text-white mb-3">@(isBangla ? "যোগাযোগের তথ্য" : "Contact Info")</h5>
                    @if (!string.IsNullOrEmpty(siteSettings?.Address))
                    {
                        <p class="text-white-50 mb-2">
                            <i class="fas fa-map-marker-alt me-2"></i>
                            @(isBangla && !string.IsNullOrEmpty(siteSettings?.AddressBn) ? siteSettings.AddressBn : siteSettings.Address)
                        </p>
                    }
                    else
                    {
                        <p class="text-white-50 mb-2">
                            <i class="fas fa-map-marker-alt me-2"></i>
                            @if (isBangla)
                            {
                                <text>হাউস - ১৫ (৫এ), রোড-০৮, ব্লক -সি, বসিলা গার্ডেন সিটি, মোহাম্মদপুর, ঢাকা-১২০৭</text>
                            }
                            else
                            {
                                <text>House - 15 (5A), Road-08, Block -C, Bosila Garden City, Mohammadpur, Dhaka-1207</text>
                            }
                        </p>
                    }
                    @if (!string.IsNullOrEmpty(siteSettings?.Phone))
                    {
                        <p class="text-white-50 mb-2">
                            <i class="fas fa-phone me-2"></i>
                            <a href="tel:@siteSettings.Phone" class="text-white-50 text-decoration-none">@siteSettings.Phone</a>
                        </p>
                    }
                    else
                    {
                        <p class="text-white-50 mb-2">
                            <i class="fas fa-phone me-2"></i>
                            <a href="tel:+8801550721313" class="text-white-50 text-decoration-none">+880 1550-721313</a>
                        </p>
                    }
                    @if (!string.IsNullOrEmpty(siteSettings?.Email))
                    {
                        <p class="text-white-50 mb-2">
                            <i class="fas fa-envelope me-2"></i>
                            <a href="mailto:@siteSettings.Email" class="text-white-50 text-decoration-none">@siteSettings.Email</a>
                        </p>
                    }
                    else
                    {
                        <p class="text-white-50 mb-2">
                            <i class="fas fa-envelope me-2"></i>
                            <a href="mailto:info@wbs-bd.org" class="text-white-50 text-decoration-none">info@wbs-bd.org</a>
                        </p>
                    }
                    @if (!string.IsNullOrEmpty(siteSettings?.RegistrationNumber))
                    {
                        <p class="text-white-50 mb-2">
                            <i class="fas fa-certificate me-2"></i>
                            @(isBangla ? "রেজিস্ট্রেশন:" : "Registration:") @siteSettings.RegistrationNumber
                        </p>
                    }
                </div>
            </div>
            <hr class="border-secondary" />
            @if (!string.IsNullOrEmpty(siteSettings?.PaymentGatewayBanner))
            {
                <div class="row mb-3">
                    <div class="col-12 text-center">
                        <img src="@siteSettings.PaymentGatewayBanner" alt="@(isBangla ? "পেমেন্ট পদ্ধতি" : "Payment Methods")" class="img-fluid" style="max-height: 80px; opacity: 0.8;" />
                    </div>
                </div>
                <hr class="border-secondary" />
            }
            <div class="row">
                <div class="col-md-6">
                    <p class="text-white-50 mb-0">
                        @{
                            var copyrightText = "";
                            if (!string.IsNullOrEmpty(siteSettings?.CopyrightText))
                            {
                                copyrightText = siteSettings.CopyrightText;
                            }
                            else
                            {
                                var siteName = siteSettings?.SiteName ?? "WBS";
                                var rights = isBangla ? "সর্বস্বত্ব সংরক্ষিত।" : "All rights reserved.";
                                copyrightText = $"© {DateTime.Now.Year} {siteName}. {rights}";
                            }
                        }
                        @copyrightText
                    </p>
                </div>
                <div class="col-md-6 text-md-end">
                    <a href="/page/privacy-policy" class="text-white-50 text-decoration-none hover-link me-3">@(isBangla ? "গোপনীয়তা নীতি" : "Privacy Policy")</a>
                    <a href="/page/terms-conditions" class="text-white-50 text-decoration-none hover-link">@(isBangla ? "শর্তাবলী" : "Terms & Conditions")</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Ensure jQuery is loaded
        if (typeof jQuery === 'undefined') {
            console.error('jQuery is not loaded!');
        } else {
            console.log('jQuery version:', jQuery.fn.jquery);
        }
        
        function toggleSearch() {
            const searchBox = document.getElementById('searchBox');
            searchBox.classList.toggle('active');
            if (searchBox.classList.contains('active')) {
                document.body.style.overflow = 'hidden';
                const input = searchBox.querySelector('input');
                setTimeout(() => input.focus(), 100);
            } else {
                document.body.style.overflow = '';
            }
        }

        // Close search on ESC key
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                const searchBox = document.getElementById('searchBox');
                if (searchBox.classList.contains('active')) {
                    toggleSearch();
                }
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
