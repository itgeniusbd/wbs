@{
    ViewData["Title"] = "Access Denied";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body text-center py-5">
                    <i class="fas fa-ban text-danger" style="font-size: 5rem;"></i>
                    <h2 class="mt-4">Access Denied</h2>
                    <p class="lead text-muted">You do not have permission to access this resource.</p>
                    <p class="text-muted">If you believe this is a mistake, please contact your administrator.</p>
                    
                    <div class="alert alert-info mt-3">
                        <i class="fas fa-info-circle"></i> 
                        <strong>Current User:</strong> @User.Identity?.Name
                    </div>

                    <div class="mt-4">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a href="/admin" class="btn btn-primary me-2">
                                <i class="fas fa-home"></i> Go to Dashboard
                            </a>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-warning me-2">
                                    <i class="fas fa-sign-out-alt"></i> Logout
                                </button>
                            </form>
                        }
                        <a href="/" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back to Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
