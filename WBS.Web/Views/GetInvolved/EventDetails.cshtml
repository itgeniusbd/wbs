@model WBS.Web.Models.Event
@using Microsoft.AspNetCore.Localization

@{
    ViewData["Title"] = Model.Title;
    var currentCulture = Context.Features.Get<IRequestCultureFeature>()?.RequestCulture.Culture.TwoLetterISOLanguageName ?? "en";
    bool isBangla = currentCulture == "bn";
    
    var title = isBangla && !string.IsNullOrEmpty(Model.TitleBn) ? Model.TitleBn : Model.Title;
    var description = isBangla && !string.IsNullOrEmpty(Model.DescriptionBn) ? Model.DescriptionBn : Model.Description;
    var location = isBangla && !string.IsNullOrEmpty(Model.LocationBn) ? Model.LocationBn : Model.Location;
    
    var isRegistrationOpen = Model.AvailableSeats > 0 && 
                            (!Model.RegistrationDeadline.HasValue || Model.RegistrationDeadline.Value > DateTime.UtcNow);
}

<section class="page-header" style="background: linear-gradient(135deg, #00a99d 0%, #0077b6 100%); padding: 80px 0;">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center text-white">
                <h1 class="display-4 fw-bold mb-3">@title</h1>
                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <span><i class="fas fa-calendar me-2"></i>@Model.StartDate.ToString("MMM dd, yyyy")</span>
                    @if (!string.IsNullOrEmpty(location))
                    {
                        <span><i class="fas fa-map-marker-alt me-2"></i>@location</span>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        
        <div class="row">
            <div class="col-lg-8 mb-4">
                @if (!string.IsNullOrEmpty(Model.FeaturedImage))
                {
                    <img src="@Model.FeaturedImage" alt="@title" class="img-fluid rounded shadow-sm mb-4" />
                }
                
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <h3 class="mb-4">@(isBangla ? "ইভেন্ট বিবরণ" : "Event Details")</h3>
                        
                        <div class="row mb-4">
                            <div class="col-md-6 mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="icon-box bg-primary text-white rounded-circle me-3" style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;">
                                        <i class="fas fa-calendar-alt"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">@(isBangla ? "তারিখ" : "Date")</small>
                                        <strong>@Model.StartDate.ToString("MMM dd, yyyy")</strong>
                                        @if (Model.EndDate.HasValue)
                                        {
                                            <br /><small>@(isBangla ? "থেকে" : "to") @Model.EndDate.Value.ToString("MMM dd, yyyy")</small>
                                        }
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="icon-box bg-success text-white rounded-circle me-3" style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;">
                                        <i class="fas fa-ticket-alt"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">@(isBangla ? "টিকেট মূল্য" : "Ticket Price")</small>
                                        @if (Model.TicketPrice.HasValue && Model.TicketPrice.Value > 0)
                                        {
                                            <strong class="text-success fs-5">Tk @Model.TicketPrice.Value.ToString("N2")</strong>
                                        }
                                        else
                                        {
                                            <strong class="text-success fs-5">@(isBangla ? "বিনামূল্যে" : "Free")</strong>
                                        }
                                    </div>
                                </div>
                            </div>
                            
                            @if (!string.IsNullOrEmpty(location))
                            {
                                <div class="col-md-6 mb-3">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-box bg-info text-white rounded-circle me-3" style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;">
                                            <i class="fas fa-map-marker-alt"></i>
                                        </div>
                                        <div>
                                            <small class="text-muted d-block">@(isBangla ? "স্থান" : "Location")</small>
                                            <strong>@location</strong>
                                        </div>
                                    </div>
                                </div>
                            }
                            
                            <div class="col-md-6 mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="icon-box bg-warning text-white rounded-circle me-3" style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;">
                                        <i class="fas fa-users"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">@(isBangla ? "উপলব্ধ আসন" : "Available Seats")</small>
                                        <strong>@Model.AvailableSeats / @Model.TotalCapacity</strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(description))
                        {
                            <hr class="my-4" />
                            <div class="event-description">
                                @Html.Raw(description)
                            </div>
                        }
                        
                        @if (Model.RegistrationDeadline.HasValue)
                        {
                            <div class="alert alert-warning mt-4">
                                <i class="fas fa-clock me-2"></i>
                                <strong>@(isBangla ? "নিবন্ধনের সময় সীমা:" : "Registration Deadline:"):</strong>
                                @Model.RegistrationDeadline.Value.ToString("MMM dd, yyyy hh:mm tt")
                            </div>
                        }
                    </div>
                </div>
                
                <div class="d-flex gap-2 mb-4">
                    <a href="/getinvolved/events" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>@(isBangla ? "সব ইভেন্ট" : "All Events")
                    </a>
                </div>
            </div>
            
            <div class="col-lg-4">
                <div class="card shadow-sm sticky-top" style="top: 100px;" id="register">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-ticket-alt me-2"></i>@(isBangla ? "এখনই নিবন্ধন করুন" : "Register Now")
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (isRegistrationOpen)
                        {
                            @if (!string.IsNullOrEmpty(Model.RegistrationUrl))
                            {
                                <div class="alert alert-info">
                                    <i class="fas fa-info-circle me-2"></i>
                                    @(isBangla ? "এই ইভেন্টটি বাহ্যিক নিবন্ধন প্রয়োজন।" : "This event requires external registration.")
                                </div>
                                <a href="@Model.RegistrationUrl" target="_blank" class="btn btn-primary w-100">
                                    <i class="fas fa-external-link-alt me-2"></i>@(isBangla ? "নিবন্ধন করুন" : "Register")
                                </a>
                            }
                            else
                            {
                                <form asp-controller="GetInvolved" asp-action="RegisterForEvent" method="post">
                                    <input type="hidden" name="eventId" value="@Model.Id" />
                                    
                                    <div class="mb-3">
                                        <label class="form-label">@(isBangla ? "সম্পূর্ণ নাম" : "Full Name") <span class="text-danger">*</span></label>
                                        <input type="text" name="fullName" class="form-control" required 
                                               placeholder="@(isBangla ? "আপনার সম্পূর্ণ নাম লিখুন" : "Enter your full name")" />
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label class="form-label">@(isBangla ? "ইমেইল" : "Email") <span class="text-danger">*</span></label>
                                        <input type="email" name="email" class="form-control" required 
                                               placeholder="@(isBangla ? "আপনার ইমেইল ঠিকানা" : "your@email.com")" />
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label class="form-label">@(isBangla ? "ফোন নম্বর" : "Phone Number") <span class="text-danger">*</span></label>
                                        <input type="tel" name="phone" class="form-control" required 
                                               placeholder="@(isBangla ? "০১৫৫০৭২১৩১৩" : "+880 1550721313")" />
                                    </div>
                                    
                                    <div class="alert alert-light border">
                                        <strong>@(isBangla ? "টিকিট মূল্য:" : "Ticket Price:"):</strong><br />
                                        @if (Model.TicketPrice.HasValue && Model.TicketPrice.Value > 0)
                                        {
                                            <h4 class="text-success mb-0">Tk @Model.TicketPrice.Value.ToString("N2")</h4>
                                            <small class="text-muted">@(isBangla ? "SSL Commerz দিয়ে পেমেন্ট করুন" : "Pay with SSL Commerz")</small>
                                        }
                                        else
                                        {
                                            <h4 class="text-success mb-0">@(isBangla ? "বিনামূল্যে" : "Free")</h4>
                                        }
                                    </div>
                                    
                                    @Html.AntiForgeryToken()
                                    
                                    <button type="submit" class="btn btn-primary w-100">
                                        @if (Model.TicketPrice.HasValue && Model.TicketPrice.Value > 0)
                                        {
                                            <i class="fas fa-credit-card me-2"></i>@(isBangla ? "পেমেন্ট করুন এবং নিশ্চিত করুন" : "Pay & Confirm")
                                        }
                                        else
                                        {
                                            <i class="fas fa-check me-2"></i>@(isBangla ? "নিশ্চিত করুন" : "Confirm Registration")
                                        }
                                    </button>
                                    
                                    @if (Model.TicketPrice.HasValue && Model.TicketPrice.Value > 0)
                                    {
                                        <p class="text-center text-muted small mt-3 mb-0">
                                            <i class="fas fa-lock me-1"></i>
                                            @(isBangla ? "নিরাপদ পেমেন্ট SSL Commerz দ্বারা সুরক্ষিত" : "Secure payment powered by SSL Commerz")
                                        </p>
                                    }
                                </form>
                            }
                        }
                        else if (Model.AvailableSeats == 0)
                        {
                            <div class="alert alert-danger">
                                <i class="fas fa-ban me-2"></i>
                                <strong>@(isBangla ? "দুঃখিত!" : "Sorry!")</strong><br />
                                @(isBangla ? "এই ইভেন্টের সমস্ত আসন বুক করা হয়েছে।" : "This event is fully booked.")
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning">
                                <i class="fas fa-times-circle me-2"></i>
                                <strong>@(isBangla ? "নিবন্ধন বন্ধ" : "Registration Closed")</strong><br />
                                @(isBangla ? "এই ইভেন্টের জন্য নিবন্ধন সময় শেষ হয়ে গেছে।" : "The registration period for this event has ended.")
                            </div>
                        }
                        
                        <div class="mt-3 pt-3 border-top">
                            <p class="small text-muted mb-0">
                                <i class="fas fa-info-circle me-1"></i>
                                @(isBangla ? "নিবন্ধনের পরে আপনি একটি নিশ্চিতকরণ ইমেল পাবেন।" : "You will receive a confirmation email after registration.")
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .event-description {
        line-height: 1.8;
    }
    
    .event-description p {
        margin-bottom: 1rem;
    }
    
    .sticky-top {
        position: sticky !important;
    }
</style>
