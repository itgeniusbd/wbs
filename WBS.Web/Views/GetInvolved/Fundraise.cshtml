@{
    ViewData["Title"] = "Fundraise";
}

<section class="page-header" style="background: linear-gradient(135deg, #00a99d 0%, #0077b6 100%); padding: 80px 0;">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center text-white">
                <h1 class="display-4 fw-bold mb-3">Fundraise for a Cause</h1>
                <p class="lead">Start your own fundraising campaign</p>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-10 mx-auto">
                <div class="card shadow-sm mb-4">
                    <div class="card-body p-5">
                        <h2 class="mb-4">Start Your Fundraising Journey</h2>
                        <p class="lead">Whether it's for your birthday, a marathon, or just because you want to help - you can make a difference by fundraising for WBS.</p>
                        
                        <hr class="my-4" />
                        
                        <div class="row">
                            <div class="col-md-4 mb-4 text-center">
                                <div class="mb-3">
                                    <i class="fas fa-gift fa-3x text-primary"></i>
                                </div>
                                <h4>Birthday Fundraiser</h4>
                                <p class="text-muted">Ask friends and family to donate instead of gifts</p>
                            </div>
                            <div class="col-md-4 mb-4 text-center">
                                <div class="mb-3">
                                    <i class="fas fa-running fa-3x text-success"></i>
                                </div>
                                <h4>Sports Challenge</h4>
                                <p class="text-muted">Run, cycle, or swim for a cause</p>
                            </div>
                            <div class="col-md-4 mb-4 text-center">
                                <div class="mb-3">
                                    <i class="fas fa-users fa-3x text-info"></i>
                                </div>
                                <h4>Community Event</h4>
                                <p class="text-muted">Organize a local event to raise funds</p>
                            </div>
                        </div>
                        
                        <div class="text-center mt-4">
                            <a href="/about/contact" class="btn btn-primary btn-lg rounded-pill px-5">
                                <i class="fas fa-envelope me-2"></i>Contact Us to Start
                            </a>
                        </div>
                    </div>
                </div>
                
                <div class="card shadow-sm">
                    <div class="card-body p-5">
                        <h3 class="mb-4">How It Works</h3>
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <div class="text-center">
                                    <div class="step-number bg-primary text-white mx-auto mb-3" style="width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: bold;">
                                        1
                                    </div>
                                    <h5>Choose Your Cause</h5>
                                    <p class="text-muted small">Select which program you want to support</p>
                                </div>
                            </div>
                            <div class="col-md-3 mb-3">
                                <div class="text-center">
                                    <div class="step-number bg-success text-white mx-auto mb-3" style="width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: bold;">
                                        2
                                    </div>
                                    <h5>Set Your Goal</h5>
                                    <p class="text-muted small">Decide how much you want to raise</p>
                                </div>
                            </div>
                            <div class="col-md-3 mb-3">
                                <div class="text-center">
                                    <div class="step-number bg-info text-white mx-auto mb-3" style="width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: bold;">
                                        3
                                    </div>
                                    <h5>Share Your Page</h5>
                                    <p class="text-muted small">Spread the word on social media</p>
                                </div>
                            </div>
                            <div class="col-md-3 mb-3">
                                <div class="text-center">
                                    <div class="step-number bg-warning text-white mx-auto mb-3" style="width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: bold;">
                                        4
                                    </div>
                                    <h5>Make Impact</h5>
                                    <p class="text-muted small">See your donations change lives</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
