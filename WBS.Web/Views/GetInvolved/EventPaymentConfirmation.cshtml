@model WBS.Web.Models.EventRegistration
@using Microsoft.AspNetCore.Localization

@{
    ViewData["Title"] = "Registration Confirmed";
    var currentCulture = Context.Features.Get<IRequestCultureFeature>()?.RequestCulture.Culture.TwoLetterISOLanguageName ?? "en";
    bool isBangla = currentCulture == "bn";
    
    var eventTitle = Model.Event != null ? 
        (isBangla && !string.IsNullOrEmpty(Model.Event.TitleBn) ? Model.Event.TitleBn : Model.Event.Title) : 
        "Event";
}

<section class="page-header" style="background: linear-gradient(135deg, #00a99d 0%, #0077b6 100%); padding: 80px 0;">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center text-white">
                <div class="mb-4">
                    <i class="fas fa-check-circle" style="font-size: 80px; color: #fff;"></i>
                </div>
                <h1 class="display-4 fw-bold mb-3">
                    @(isBangla ? "নিবন্ধন সফল!" : "Registration Confirmed!")
                </h1>
                <p class="lead">
                    @(isBangla ? "আপনার পেমেন্ট সফল হয়েছে এবং ইভেন্ট রেজিস্ট্রেশন নিশ্চিত করা হয়েছে" : "Your payment was successful and event registration is confirmed")
                </p>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-lg border-0">
                    <div class="card-body p-5">
                        <div class="text-center mb-4">
                            <div class="mb-3">
                                <i class="fas fa-ticket-alt text-success" style="font-size: 60px;"></i>
                            </div>
                            <h2 class="fw-bold text-success mb-2">
                                @(isBangla ? "পেমেন্ট সফল হয়েছে!" : "Payment Successful!")
                            </h2>
                            <p class="text-muted">
                                @(isBangla ? "আপনার ইভেন্ট টিকিট নিশ্চিত করা হয়েছে" : "Your event ticket has been confirmed")
                            </p>
                        </div>

                        <hr class="my-4" />

                        <div class="row mb-4">
                            <div class="col-md-6 mb-3">
                                <label class="text-muted small d-block mb-1">@(isBangla ? "ইভেন্ট" : "Event")</label>
                                <strong class="fs-5">@eventTitle</strong>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="text-muted small d-block mb-1">@(isBangla ? "রেজিস্ট্রেশন আইডি" : "Registration ID")</label>
                                <strong class="fs-5">@Model.Id</strong>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6 mb-3">
                                <label class="text-muted small d-block mb-1">@(isBangla ? "অংশগ্রহণকারী" : "Participant")</label>
                                <strong>@Model.FullName</strong>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="text-muted small d-block mb-1">@(isBangla ? "ইমেইল" : "Email")</label>
                                <strong>@Model.Email</strong>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6 mb-3">
                                <label class="text-muted small d-block mb-1">@(isBangla ? "ফোন" : "Phone")</label>
                                <strong>@Model.Phone</strong>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="text-muted small d-block mb-1">@(isBangla ? "পেমেন্ট পদ্ধতি" : "Payment Method")</label>
                                <strong>@Model.PaymentMethod</strong>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6 mb-3">
                                <label class="text-muted small d-block mb-1">@(isBangla ? "পরিশোধিত পরিমাণ" : "Amount Paid")</label>
                                <strong class="text-success fs-4">Tk @Model.AmountPaid.ToString("N2")</strong>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="text-muted small d-block mb-1">@(isBangla ? "লেনদেন আইডি" : "Transaction ID")</label>
                                <strong class="small">@Model.TransactionId</strong>
                            </div>
                        </div>

                        @if (Model.Event != null)
                        {
                            <div class="alert alert-info">
                                <i class="fas fa-calendar-alt me-2"></i>
                                <strong>@(isBangla ? "ইভেন্টের তারিখ:" : "Event Date:"):</strong>
                                @Model.Event.StartDate.ToString("dddd, MMMM dd, yyyy")
                                @if (!string.IsNullOrEmpty(Model.Event.Location) || !string.IsNullOrEmpty(Model.Event.LocationBn))
                                {
                                    <br />
                                    <i class="fas fa-map-marker-alt me-2"></i>
                                    <strong>@(isBangla ? "স্থান:" : "Location:"):</strong>
                                    @(isBangla && !string.IsNullOrEmpty(Model.Event.LocationBn) ? Model.Event.LocationBn : Model.Event.Location)
                                }
                            </div>
                        }

                        <div class="alert alert-success">
                            <i class="fas fa-envelope me-2"></i>
                            @(isBangla ? 
                                "একটি নিশ্চিতকরণ ইমেল আপনার ইমেল ঠিকানায় পাঠানো হয়েছে।" : 
                                "A confirmation email has been sent to your email address.")
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex gap-3 justify-content-center flex-wrap">
                            <a href="/getinvolved/events" class="btn btn-outline-primary">
                                <i class="fas fa-calendar me-2"></i>@(isBangla ? "আরো ইভেন্ট দেখুন" : "View More Events")
                            </a>
                            <a href="/" class="btn btn-primary">
                                <i class="fas fa-home me-2"></i>@(isBangla ? "হোম পেজে যান" : "Go to Homepage")
                            </a>
                        </div>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <p class="text-muted">
                        @(isBangla ? 
                            "যদি আপনার কোন প্রশ্ন থাকে, অনুগ্রহ করে আমাদের সাথে যোগাযোগ করুন।" : 
                            "If you have any questions, please feel free to contact us.")
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .card {
        border-radius: 15px;
    }
    
    .alert {
        border-radius: 10px;
    }
</style>
