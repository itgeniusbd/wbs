@model IEnumerable<WBS.Web.Models.Event>
@using Microsoft.AspNetCore.Localization

@{
    ViewData["Title"] = "Events";
    var currentCulture = Context.Features.Get<IRequestCultureFeature>()?.RequestCulture.Culture.TwoLetterISOLanguageName ?? "en";
    bool isBangla = currentCulture == "bn";
}

<section class="page-header" style="background: linear-gradient(135deg, #00a99d 0%, #0077b6 100%); padding: 80px 0;">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center text-white">
                <h1 class="display-4 fw-bold mb-3">@(isBangla ? "আমাদের ইভেন্ট" : "Events")</h1>
                <p class="lead">@(isBangla ? "আমাদের আগামী ইভেন্টগুলিতে যোগ দিন এবং একটি পার্থক্য তৈরি করুন" : "Join our upcoming events and make a difference")</p>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        
        @if (Model != null && Model.Any())
        {
            <div class="row">
                @foreach (var eventItem in Model)
                {
                    var title = isBangla && !string.IsNullOrEmpty(eventItem.TitleBn) ? eventItem.TitleBn : eventItem.Title;
                    var description = isBangla && !string.IsNullOrEmpty(eventItem.DescriptionBn) ? eventItem.DescriptionBn : eventItem.Description;
                    var location = isBangla && !string.IsNullOrEmpty(eventItem.LocationBn) ? eventItem.LocationBn : eventItem.Location;
                    var isRegistrationOpen = eventItem.AvailableSeats > 0 && 
                                            (!eventItem.RegistrationDeadline.HasValue || eventItem.RegistrationDeadline.Value > DateTime.UtcNow);
                    
                    <div class="col-lg-6 mb-4">
                        <div class="card h-100 shadow-sm hover-shadow">
                            @if (!string.IsNullOrEmpty(eventItem.FeaturedImage))
                            {
                                <img src="@eventItem.FeaturedImage" class="card-img-top" alt="@title" style="height: 250px; object-fit: cover;" />
                            }
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <h4 class="card-title mb-0">@title</h4>
                                    @if (eventItem.IsFeatured)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="fas fa-star me-1"></i>@(isBangla ? "বৈশিষ্ট্যযুক্ত" : "Featured")
                                        </span>
                                    }
                                </div>
                                
                                <div class="mb-3">
                                    <p class="mb-2">
                                        <i class="fas fa-calendar text-primary me-2"></i>
                                        <strong>@eventItem.StartDate.ToString("MMM dd, yyyy")</strong>
                                        @if (eventItem.EndDate.HasValue)
                                        {
                                            <span>- @eventItem.EndDate.Value.ToString("MMM dd, yyyy")</span>
                                        }
                                    </p>
                                    
                                    @if (!string.IsNullOrEmpty(location))
                                    {
                                        <p class="mb-2">
                                            <i class="fas fa-map-marker-alt text-primary me-2"></i>
                                            @location
                                        </p>
                                    }
                                    
                                    <p class="mb-2">
                                        <i class="fas fa-ticket-alt text-primary me-2"></i>
                                        <strong>@(isBangla ? "টিকেট মূল্য:" : "Ticket Price:"):</strong>
                                        @if (eventItem.TicketPrice.HasValue && eventItem.TicketPrice.Value > 0)
                                        {
                                            <span class="text-success fw-bold">৳@eventItem.TicketPrice.Value.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-success fw-bold">@(isBangla ? "বিনামূল্যে" : "Free")</span>
                                        }
                                    </p>
                                    
                                    <p class="mb-2">
                                        <i class="fas fa-users text-primary me-2"></i>
                                        <strong>@(isBangla ? "আসন:" : "Seats:"):</strong>
                                        @eventItem.RegisteredCount / @eventItem.TotalCapacity
                                        @if (eventItem.AvailableSeats > 0)
                                        {
                                            <span class="text-success">(@eventItem.AvailableSeats @(isBangla ? "টি বাকি" : "left"))</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">(@(isBangla ? "পূর্ণ" : "Full"))</span>
                                        }
                                    </p>
                                    
                                    @if (eventItem.RegistrationDeadline.HasValue)
                                    {
                                        <p class="mb-2">
                                            <i class="far fa-clock text-primary me-2"></i>
                                            <strong>@(isBangla ? "নিবন্ধন শেষ:" : "Registration Deadline:"):</strong>
                                            @eventItem.RegistrationDeadline.Value.ToString("MMM dd, yyyy hh:mm tt")
                                        </p>
                                    }
                                </div>
                                
                                @if (!string.IsNullOrEmpty(description))
                                {
                                    <p class="card-text text-muted flex-grow-1">
                                        @(description != null && description.Length > 150 ? Html.Raw(description.Substring(0, 150) + "...") : Html.Raw(description ?? ""))
                                    </p>
                                }
                                
                                <div class="mt-auto">
                                    <div class="d-flex gap-2">
                                        <a href="/getinvolved/events/@eventItem.Id" class="btn btn-primary">
                                            <i class="fas fa-info-circle me-2"></i>@(isBangla ? "বিস্তারিত দেখুন" : "View Details")
                                        </a>
                                        
                                        @if (isRegistrationOpen)
                                        {
                                            <a href="/getinvolved/events/@eventItem.Id#register" class="btn btn-success">
                                                <i class="fas fa-ticket-alt me-2"></i>@(isBangla ? "নিবন্ধন করুন" : "Register Now")
                                            </a>
                                        }
                                        else if (eventItem.AvailableSeats == 0)
                                        {
                                            <button class="btn btn-secondary" disabled>
                                                <i class="fas fa-ban me-2"></i>@(isBangla ? "পূর্ণ" : "Fully Booked")
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-secondary" disabled>
                                                <i class="fas fa-times me-2"></i>@(isBangla ? "নিবন্ধন বন্ধ" : "Registration Closed")
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-12">
                    <div class="alert alert-info text-center py-5">
                        <i class="fas fa-calendar-alt fa-3x mb-3"></i>
                        <h4>@(isBangla ? "বর্তমানে কোন ইভেন্ট নেই" : "No Events Available")</h4>
                        <p class="mb-0">@(isBangla ? "শীঘ্রই নতুন ইভেন্ট আসছে। আপডেটের জন্য নজর রাখুন!" : "New events coming soon. Stay tuned for updates!")</p>
                    </div>
                </div>
            </div>
        }
        
        <div class="row mt-5">
            <div class="col-12">
                <div class="card bg-light">
                    <div class="card-body text-center py-4">
                        <h5 class="mb-3">@(isBangla ? "আমাদের ইভেন্টগুলি সম্পর্কে জানতে চান?" : "Want to Learn About Our Events?")</h5>
                        <p class="mb-3">@(isBangla ? "আমরা নিয়মিত বিভিন্ন ধরনের ইভেন্ট আয়োজন করি যেখানে আপনি অংশগ্রহণ করে সমাজে অবদান রাখতে পারেন।" : "We regularly organize various types of events where you can participate and contribute to society.")</p>
                        <a href="/about/contact" class="btn btn-primary">
                            <i class="fas fa-envelope me-2"></i>@(isBangla ? "যোগাযোগ করুন" : "Contact Us")
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .hover-shadow {
        transition: all 0.3s ease;
    }
    
    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }
</style>
