@{
    ViewData["Title"] = "Our Team";
}

<section class="page-header" style="background: linear-gradient(135deg, #00a99d 0%, #0077b6 100%); padding: 80px 0;">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center text-white">
                <h1 class="display-4 fw-bold mb-3">Our Team</h1>
                <p class="lead">Meet the dedicated people behind WBS</p>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-10 mx-auto">
                <div class="text-center mb-5">
                    <h2>Leadership Team</h2>
                    <p class="lead text-muted">Our experienced team working to make a difference</p>
                </div>
                
                <div class="row">
                    <div class="col-md-4 mb-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-body text-center p-4">
                                <div class="avatar-circle bg-primary text-white mx-auto mb-3" style="width: 120px; height: 120px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 48px;">
                                    <i class="fas fa-user"></i>
                                </div>
                                <h4>Dr. Ahmed Rahman</h4>
                                <p class="text-primary mb-3">Chairman</p>
                                <p class="text-muted small">Leading WBS with over 20 years of experience in social development</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-4 mb-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-body text-center p-4">
                                <div class="avatar-circle bg-success text-white mx-auto mb-3" style="width: 120px; height: 120px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 48px;">
                                    <i class="fas fa-user"></i>
                                </div>
                                <h4>Fatima Begum</h4>
                                <p class="text-success mb-3">Executive Director</p>
                                <p class="text-muted small">Managing day-to-day operations and program implementation</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-4 mb-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-body text-center p-4">
                                <div class="avatar-circle bg-info text-white mx-auto mb-3" style="width: 120px; height: 120px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 48px;">
                                    <i class="fas fa-user"></i>
                                </div>
                                <h4>Mohammad Karim</h4>
                                <p class="text-info mb-3">Program Director</p>
                                <p class="text-muted small">Overseeing all programs and ensuring quality delivery</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="text-center mt-5">
                    <a href="/about/contact" class="btn btn-primary btn-lg rounded-pill px-5">
                        <i class="fas fa-envelope me-2"></i>Contact Us
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
