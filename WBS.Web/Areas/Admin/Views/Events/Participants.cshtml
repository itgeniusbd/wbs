@model IEnumerable<WBS.Web.Models.EventRegistration>

@{
    ViewData["Title"] = "Event Participants";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var eventModel = ViewBag.Event as WBS.Web.Models.Event;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="fas fa-users me-2"></i>Event Participants</h2>
        <p class="text-muted mb-0">@(eventModel?.Title ?? "Event")</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back to Events List
    </a>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card border-primary">
            <div class="card-body text-center">
                <i class="fas fa-users fa-2x text-primary mb-2"></i>
                <h3 class="mb-0">@(eventModel?.TotalCapacity ?? 0)</h3>
                <p class="text-muted mb-0">Total Capacity</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-success">
            <div class="card-body text-center">
                <i class="fas fa-user-check fa-2x text-success mb-2"></i>
                <h3 class="mb-0">@(eventModel?.RegisteredCount ?? 0)</h3>
                <p class="text-muted mb-0">Confirmed</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-warning">
            <div class="card-body text-center">
                <i class="fas fa-chair fa-2x text-warning mb-2"></i>
                <h3 class="mb-0">@(eventModel?.AvailableSeats ?? 0)</h3>
                <p class="text-muted mb-0">Available Seats</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-info">
            <div class="card-body text-center">
                <i class="fas fa-money-bill-wave fa-2x text-info mb-2"></i>
                <h3 class="mb-0">?@(Model.Where(r => r.Status == "Confirmed").Sum(r => r.AmountPaid).ToString("N2"))</h3>
                <p class="text-muted mb-0">Total Revenue</p>
            </div>
        </div>
    </div>
</div>

<div class="card shadow">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Participant List</h5>
            <button class="btn btn-sm btn-success" onclick="exportToCSV()">
                <i class="fas fa-download me-1"></i>Export CSV
            </button>
        </div>
        
        <div class="table-responsive">
            <table class="table table-hover" id="participantsTable">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Amount Paid</th>
                        <th>Status</th>
                        <th>Registered On</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var counter = 1;
                        @foreach (var participant in Model)
                        {
                            <tr>
                                <td>@counter</td>
                                <td><strong>@participant.FullName</strong></td>
                                <td>
                                    <a href="mailto:@participant.Email">@participant.Email</a>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(participant.Phone))
                                    {
                                        <a href="tel:@participant.Phone">@participant.Phone</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td>
                                    @if (participant.AmountPaid > 0)
                                    {
                                        <span class="badge bg-success">?@participant.AmountPaid.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">Free</span>
                                    }
                                </td>
                                <td>
                                    @if (participant.Status == "Confirmed")
                                    {
                                        <span class="badge bg-success"><i class="fas fa-check me-1"></i>@participant.Status</span>
                                    }
                                    else if (participant.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i>@participant.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@participant.Status</span>
                                    }
                                </td>
                                <td>
                                    <small>@participant.RegisteredAt.ToString("MMM dd, yyyy hh:mm tt")</small>
                                </td>
                            </tr>
                            counter++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <i class="fas fa-users fa-3x text-muted mb-3 d-block"></i>
                                <h5 class="text-muted">No participants yet</h5>
                                <p class="text-muted">Registrations will appear here once people start signing up.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-list me-2"></i>Back to All Events
    </a>
</div>

@section Scripts {
    <script>
        function exportToCSV() {
            const table = document.getElementById('participantsTable');
            const rows = table.querySelectorAll('tr');
            let csv = [];
            
            for (let i = 0; i < rows.length; i++) {
                const row = rows[i];
                const cols = row.querySelectorAll('td, th');
                let csvRow = [];
                
                for (let j = 0; j < cols.length - 1; j++) {
                    let data = cols[j].innerText.replace(/"/g, '""');
                    csvRow.push('"' + data + '"');
                }
                
                csv.push(csvRow.join(','));
            }
            
            const csvString = csv.join('\n');
            const blob = new Blob([csvString], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            const url = URL.createObjectURL(blob);
            
            link.setAttribute('href', url);
            link.setAttribute('download', 'event-participants-@(eventModel.Id)-@(DateTime.Now.ToString("yyyyMMdd")).csv');
            link.style.visibility = 'hidden';
            
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
}
