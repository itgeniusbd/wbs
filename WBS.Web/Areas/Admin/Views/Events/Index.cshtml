@model IEnumerable<WBS.Web.Models.Event>

@{
    ViewData["Title"] = "Events Management";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-calendar-alt me-2"></i>Events Management</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>Create New Event
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert" id="successAlert" style="border-left: 4px solid #198754;">
        <div class="d-flex align-items-center">
            <i class="fas fa-check-circle me-3" style="font-size: 1.5rem;"></i>
            <div class="flex-grow-1">
                <strong>Success!</strong>
                <p class="mb-0">@TempData["Success"]</p>
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert" style="border-left: 4px solid #dc3545;">
        <div class="d-flex align-items-center">
            <i class="fas fa-exclamation-circle me-3" style="font-size: 1.5rem;"></i>
            <div class="flex-grow-1">
                <strong>Error!</strong>
                <p class="mb-0">@TempData["Error"]</p>
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th style="width: 100px;">Image</th>
                        <th>Event Title</th>
                        <th>Date & Time</th>
                        <th>Location</th>
                        <th>Ticket Price</th>
                        <th>Capacity</th>
                        <th>Registered</th>
                        <th>Status</th>
                        <th style="width: 200px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.FeaturedImage))
                                    {
                                        <img src="@item.FeaturedImage" alt="@item.Title" class="img-thumbnail" style="max-height: 60px; max-width: 100px; object-fit: cover;" onerror="this.src='/images/no-image.png'" />
                                    }
                                    else
                                    {
                                        <div class="bg-light d-flex align-items-center justify-content-center" style="width: 100px; height: 60px; border-radius: 5px;">
                                            <i class="fas fa-calendar-alt text-muted"></i>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <strong>@item.Title</strong>
                                    @if (!string.IsNullOrEmpty(item.TitleBn))
                                    {
                                        <br /><small class="text-muted" style="font-family: 'Noto Sans Bengali', sans-serif;">@item.TitleBn</small>
                                    }
                                    @if (item.IsFeatured)
                                    {
                                        <br /><span class="badge bg-warning text-dark mt-1"><i class="fas fa-star me-1"></i>Featured</span>
                                    }
                                </td>
                                <td>
                                    <small>
                                        <i class="fas fa-calendar me-1"></i>@item.StartDate.ToString("MMM dd, yyyy")<br />
                                        @if (item.EndDate.HasValue)
                                        {
                                            <span>to @item.EndDate.Value.ToString("MMM dd, yyyy")</span>
                                        }
                                    </small>
                                </td>
                                <td>
                                    <small>
                                        <i class="fas fa-map-marker-alt me-1"></i>@item.Location
                                    </small>
                                </td>
                                <td>
                                    @if (item.TicketPrice.HasValue && item.TicketPrice.Value > 0)
                                    {
                                        <span class="badge bg-success">?@item.TicketPrice.Value.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">Free</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@item.TotalCapacity</span>
                                </td>
                                <td>
                                    <span class="badge bg-primary">@item.RegisteredCount / @item.TotalCapacity</span>
                                    @if (item.AvailableSeats > 0)
                                    {
                                        <br /><small class="text-success">@item.AvailableSeats seats left</small>
                                    }
                                    else
                                    {
                                        <br /><small class="text-danger">Full</small>
                                    }
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        @if (item.RegistrationDeadline.HasValue && item.RegistrationDeadline.Value < DateTime.UtcNow)
                                        {
                                            <span class="badge bg-danger"><i class="fas fa-times me-1"></i>Registration Closed</span>
                                        }
                                        else if (item.AvailableSeats == 0)
                                        {
                                            <span class="badge bg-warning text-dark"><i class="fas fa-ban me-1"></i>Full</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success"><i class="fas fa-check me-1"></i>Active</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary"><i class="fas fa-times me-1"></i>Inactive</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group mb-1" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteEvent(@item.Id)" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                    <br />
                                    <a asp-action="Participants" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info w-100 mt-1" title="View Participants">
                                        <i class="fas fa-users me-1"></i>Participants (@item.RegisteredCount)
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5">
                                <i class="fas fa-calendar-alt fa-3x text-muted mb-3 d-block"></i>
                                <h5 class="text-muted">No events found</h5>
                                <p class="text-muted mb-3">Create your first event to get started!</p>
                                <a asp-action="Create" class="btn btn-primary">
                                    <i class="fas fa-plus me-2"></i>Create New Event
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="alert alert-info mt-3">
    <i class="fas fa-info-circle me-2"></i>
    <strong>Tip:</strong> Recommended image size for event featured image is <strong>1200x600px</strong> or similar aspect ratio.
</div>

@section Scripts {
    <script>
        // Auto-hide success message after 5 seconds
        const successAlert = document.getElementById('successAlert');
        if (successAlert) {
            setTimeout(function() {
                const bsAlert = new bootstrap.Alert(successAlert);
                bsAlert.close();
            }, 5000);
        }

        function deleteEvent(id) {
            if (confirm('Are you sure you want to delete this event? This action cannot be undone.')) {
                var form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Admin/Events/Delete/' + id;

                var token = document.querySelector('input[name="__RequestVerificationToken"]');
                if (token) {
                    var input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = '__RequestVerificationToken';
                    input.value = token.value;
                    form.appendChild(input);
                }

                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
}

<form method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>
