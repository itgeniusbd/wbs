@model List<WBS.Web.Models.Donation>
@{
    ViewData["Title"] = "Donations Management";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-hand-holding-usd me-2"></i>Donations Management</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>Add Manual Donation
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <h6 class="text-uppercase">Total Donations</h6>
                <h3 class="mb-0">@ViewBag.TotalDonations</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body">
                <h6 class="text-uppercase">Total Amount</h6>
                <h3 class="mb-0">Tk @ViewBag.TotalAmount.ToString("N0")</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-white">
            <div class="card-body">
                <h6 class="text-uppercase">Pending</h6>
                <h3 class="mb-0">Tk @ViewBag.PendingAmount.ToString("N0")</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body">
                <h6 class="text-uppercase">Completed</h6>
                <h3 class="mb-0">Tk @ViewBag.CompletedAmount.ToString("N0")</h3>
            </div>
        </div>
    </div>
</div>

<!-- Filters and Actions -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Search</label>
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Name, Email, Phone, Txn ID" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Donation Type</label>
                <select name="donationTypeId" class="form-select">
                    <option value="">All Types</option>
                    @foreach (var item in (ViewBag.DonationTypes as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>) ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                    {
                        <option value="@item.Value" selected="@(item.Value == ViewBag.SelectedTypeId?.ToString())">@item.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                    <option value="">All Status</option>
                    <option value="Pending" selected="@(ViewBag.SelectedStatus?.ToString() == "Pending")">Pending</option>
                    <option value="Completed" selected="@(ViewBag.SelectedStatus?.ToString() == "Completed")">Completed</option>
                    <option value="Failed" selected="@(ViewBag.SelectedStatus?.ToString() == "Failed")">Failed</option>
                    <option value="Cancelled" selected="@(ViewBag.SelectedStatus?.ToString() == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">From Date</label>
                <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">To Date</label>
                <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control" />
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </form>
        <div class="mt-3">
            <a asp-action="Reports" class="btn btn-info btn-sm">
                <i class="fas fa-chart-bar me-1"></i>Reports
            </a>
            <a asp-action="Export" class="btn btn-success btn-sm">
                <i class="fas fa-file-excel me-1"></i>Export CSV
            </a>
        </div>
    </div>
</div>

<!-- Donations Table -->
<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Donor Name</th>
                        <th>Donor Type</th>
                        <th>Contact</th>
                        <th>Amount</th>
                        <th>Type</th>
                        <th>Payment Method</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var donation in Model)
                        {
                            <tr>
                                <td><strong>#@donation.Id</strong></td>
                                <td>
                                    @donation.DonorName
                                    @if (donation.IsAnonymous)
                                    {
                                        <span class="badge bg-secondary">Anonymous</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(donation.DonorType))
                                    {
                                        <span class="badge bg-primary">@donation.DonorType</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <small>
                                        <i class="fas fa-envelope me-1"></i>@donation.Email<br />
                                        <i class="fas fa-phone me-1"></i>@donation.Phone
                                    </small>
                                </td>
                                <td><strong>Tk @donation.Amount.ToString("N0")</strong></td>
                                <td>@donation.DonationType?.Name</td>
                                <td>
                                    @if (donation.PaymentMethod == "bKash")
                                    {
                                        <span class="badge" style="background-color: #E2136E;">bKash</span>
                                    }
                                    else if (donation.PaymentMethod == "Nagad")
                                    {
                                        <span class="badge" style="background-color: #F47920;">Nagad</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@donation.PaymentMethod</span>
                                    }
                                </td>
                                <td>
                                    @if (donation.Status == WBS.Web.Models.DonationStatus.Pending)
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else if (donation.Status == WBS.Web.Models.DonationStatus.Completed)
                                    {
                                        <span class="badge bg-success">Completed</span>
                                    }
                                    else if (donation.Status == WBS.Web.Models.DonationStatus.Failed)
                                    {
                                        <span class="badge bg-danger">Failed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Cancelled</span>
                                    }
                                </td>
                                <td>
                                    <small>@donation.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")<br />@donation.CreatedAt.ToLocalTime().ToString("hh:mm tt")</small>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@donation.Id" class="btn btn-sm btn-info" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Invoice" asp-route-id="@donation.Id" class="btn btn-sm btn-secondary" title="Invoice" target="_blank">
                                            <i class="fas fa-file-invoice"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center py-4">
                                <i class="fas fa-inbox fa-3x text-muted mb-3 d-block"></i>
                                <h5 class="text-muted">No donations found</h5>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (ViewBag.TotalPages > 1)
        {
            <nav aria-label="Page navigation" class="mt-3">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" href="?page=@i&searchTerm=@ViewBag.SearchTerm&donationTypeId=@ViewBag.SelectedTypeId&status=@ViewBag.SelectedStatus&fromDate=@ViewBag.FromDate&toDate=@ViewBag.ToDate">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>
