@model WBS.Web.Models.Donation
@{
    ViewData["Title"] = "Add Manual Donation";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">
                    <i class="fas fa-hand-holding-usd me-2"></i>Add Manual Donation
                </h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <h5 class="border-bottom pb-2 mb-3">Donor Information</h5>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DonorName" class="form-label">Donor Name *</label>
                            <input asp-for="DonorName" class="form-control" required />
                            <span asp-validation-for="DonorName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label">Email *</label>
                            <input asp-for="Email" type="email" class="form-control" required />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Phone" class="form-label">Phone *</label>
                            <input asp-for="Phone" class="form-control" placeholder="+880" required />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Address" class="form-label">Address</label>
                            <input asp-for="Address" class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DonorType" class="form-label">Donor Type</label>
                            <div class="input-group">
                                <select asp-for="DonorType" class="form-select" id="donorTypeSelect">
                                    <option value="">-- Select Donor Type --</option>
                                </select>
                                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addDonorTypeModal">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>
                            <small class="form-text text-muted">Specify donor category for better tracking</small>
                        </div>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="IsAnonymous" class="form-check-input" type="checkbox" />
                        <label asp-for="IsAnonymous" class="form-check-label">
                            Make this donation anonymous
                        </label>
                    </div>

                    <h5 class="border-bottom pb-2 mb-3 mt-4">Donation Details</h5>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Amount" class="form-label">Amount (Tk) *</label>
                            <input asp-for="Amount" type="number" step="0.01" class="form-control" required />
                            <span asp-validation-for="Amount" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Currency" class="form-label">Currency</label>
                            <select asp-for="Currency" class="form-select">
                                <option value="BDT">BDT (Tk)</option>
                                <option value="USD">USD ($)</option>
                                <option value="EUR">EUR (€)</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DonationTypeId" class="form-label">Donation Type *</label>
                            <div class="input-group">
                                <select asp-for="DonationTypeId" class="form-select" id="donationTypeSelect" required>
                                    <option value="">-- Select Type --</option>
                                    @foreach (var item in (ViewBag.DonationTypes as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>) ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                </select>
                                <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#addDonationTypeModal">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>
                            <span asp-validation-for="DonationTypeId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="AppealId" class="form-label">Appeal (Optional)</label>
                            <select asp-for="AppealId" class="form-select">
                                <option value="">-- General Donation --</option>
                                @foreach (var item in (ViewBag.Appeals as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>) ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="SDGId" class="form-label">SDG Goal *</label>
                            <select asp-for="SDGId" class="form-select" id="sdgSelect" required>
                                <option value="">-- Select SDG --</option>
                                @foreach (var item in (ViewBag.SDGs as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>) ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                            <span asp-validation-for="SDGId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ProgramId" class="form-label">Program *</label>
                            <select asp-for="ProgramId" class="form-select" id="programSelect" required disabled>
                                <option value="">-- First Select SDG --</option>
                            </select>
                            <span asp-validation-for="ProgramId" class="text-danger"></span>
                        </div>
                    </div>

                    <h5 class="border-bottom pb-2 mb-3 mt-4">Payment Information</h5>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PaymentMethod" class="form-label">Payment Method *</label>
                            <div class="input-group">
                                <select asp-for="PaymentMethod" class="form-select" id="paymentMethodSelect" required>
                                    <option value="">-- Select Method --</option>
                                </select>
                                <button type="button" class="btn btn-outline-info" data-bs-toggle="modal" data-bs-target="#addPaymentMethodModal">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>
                            <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="TransactionId" class="form-label">Transaction ID</label>
                            <input asp-for="TransactionId" class="form-control" placeholder="Auto-generated if empty" />
                            <small class="form-text text-muted">Leave empty to auto-generate</small>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Status" class="form-label">Status *</label>
                            <select asp-for="Status" class="form-select" required>
                                <option value="0">Pending</option>
                                <option value="1" selected>Completed</option>
                                <option value="2">Failed</option>
                                <option value="3">Cancelled</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="AccountId" class="form-label">Account *</label>
                            <select asp-for="AccountId" class="form-select" required>
                                <option value="">-- Select Account --</option>
                                @foreach (var account in (ViewBag.Accounts as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>) ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                                {
                                    <option value="@account.Value">@account.Text</option>
                                }
                            </select>
                            <span asp-validation-for="AccountId" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Donation Date</label>
                            <input type="datetime-local" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" readonly />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label">Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Any additional information..."></textarea>
                    </div>

                    <div class="form-check mb-4">
                        <input type="checkbox" name="sendNotifications" class="form-check-input" id="sendNotifications" value="true" checked />
                        <label class="form-check-label" for="sendNotifications">
                            Send SMS and Email notifications to donor
                        </label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i>Save Donation
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-times me-2"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Add Donor Type Modal -->
<div class="modal fade" id="addDonorTypeModal" tabindex="-1" aria-labelledby="addDonorTypeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="addDonorTypeModalLabel">
                    <i class="fas fa-user-tag me-2"></i>Manage Donor Types
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Add New Donor Type Form -->
                <div class="card mb-3">
                    <div class="card-header bg-light">
                        <h6 class="mb-0">
                            <i class="fas fa-plus-circle me-2"></i>Add New Donor Type
                        </h6>
                    </div>
                    <div class="card-body">
                        <form id="addDonorTypeForm">
                            <input type="hidden" id="editDonorTypeId" />
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="newDonorTypeName" class="form-label">Donor Type Name (English) *</label>
                                    <input type="text" class="form-control" id="newDonorTypeName" placeholder="e.g., Weekly Donor" required />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="newDonorTypeNameBn" class="form-label">Donor Type Name (বাংলা)</label>
                                    <input type="text" class="form-control" id="newDonorTypeNameBn" placeholder="যেমন: সাপ্তাহিক দাতা" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label for="newDonorTypeDescription" class="form-label">Description</label>
                                    <textarea class="form-control" id="newDonorTypeDescription" rows="2" placeholder="Optional description..."></textarea>
                                </div>
                            </div>
                            <button type="button" class="btn btn-primary btn-sm" id="saveDonorTypeBtn">
                                <i class="fas fa-save me-2"></i><span id="saveBtnText">Add Donor Type</span>
                            </button>
                            <button type="button" class="btn btn-secondary btn-sm" id="cancelEditBtn" style="display: none;">
                                <i class="fas fa-times me-2"></i>Cancel
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Existing Donor Types List -->
                <div class="card">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">
                            <i class="fas fa-list me-2"></i>Existing Donor Types
                        </h6>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="loadDonorTypesList()">
                            <i class="fas fa-sync-alt me-1"></i>Refresh
                        </button>
                    </div>
                    <div class="card-body">
                        <div id="donorTypesListLoading" class="text-center py-3">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2 mb-0 text-muted">Loading donor types...</p>
                        </div>
                        <div id="donorTypesList" class="list-group" style="display: none; max-height: 300px; overflow-y: auto;"></div>
                        <div id="donorTypesEmpty" class="alert alert-info mb-0" style="display: none;">
                            <i class="fas fa-info-circle me-2"></i>No donor types found. Add your first donor type above.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

