@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let allDonorTypes = [];
        let allDonationTypes = [];
        let allPaymentMethods = [];

        // Load Payment Methods from database
        async function loadPaymentMethods() {
            try {
                console.log('Loading payment methods from API...');
                const response = await fetch('/api/paymentmethods');
                
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                }
                
                allPaymentMethods = await response.json();
                console.log('Loaded payment methods:', allPaymentMethods);
                
                const paymentMethodSelect = document.getElementById('paymentMethodSelect');
                const currentValue = paymentMethodSelect.value;
                paymentMethodSelect.innerHTML = '<option value="">-- Select Method --</option>';
                
                allPaymentMethods.forEach(pm => {
                    const option = document.createElement('option');
                    option.value = pm.name;
                    const displayText = pm.nameBn ? `${pm.name} / ${pm.nameBn}` : pm.name;
                    option.textContent = pm.icon ? `${pm.icon} ${displayText}` : displayText;
                    paymentMethodSelect.appendChild(option);
                });
                
                // Restore previous selection if exists
                if (currentValue) {
                    paymentMethodSelect.value = currentValue;
                }
                
                console.log('Payment methods dropdown populated successfully');
            } catch (error) {
                console.error('Error loading payment methods:', error);
                const paymentMethodSelect = document.getElementById('paymentMethodSelect');
                paymentMethodSelect.innerHTML = '<option value="">Error loading payment methods</option>';
            }
        }

        // Load Payment Methods List in Modal
        async function loadPaymentMethodsList() {
            const listContainer = document.getElementById('paymentMethodsList');
            const loadingDiv = document.getElementById('paymentMethodsListLoading');
            const emptyDiv = document.getElementById('paymentMethodsEmpty');

            loadingDiv.style.display = 'block';
            listContainer.style.display = 'none';
            emptyDiv.style.display = 'none';
            listContainer.innerHTML = '';

            try {
                const response = await fetch('/api/paymentmethods');
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const paymentMethods = await response.json();
                console.log('Received payment methods:', paymentMethods);
                
                loadingDiv.style.display = 'none';

                if (paymentMethods && Array.isArray(paymentMethods) && paymentMethods.length > 0) {
                    listContainer.style.display = 'block';
                    
                    paymentMethods.forEach(pm => {
                        const listItem = document.createElement('div');
                        listItem.className = 'list-group-item d-flex justify-content-between align-items-start';
                        listItem.innerHTML = `
                            <div class="ms-2 me-auto">
                                <div class="fw-bold">
                                    ${pm.icon ? `<i class="${pm.icon} me-2"></i>` : ''}
                                    ${escapeHtml(pm.name)}
                                </div>
                                ${pm.nameBn ? `<small class="text-muted">${escapeHtml(pm.nameBn)}</small>` : ''}
                                ${pm.description ? `<div><small>${escapeHtml(pm.description)}</small></div>` : ''}
                                ${pm.displayOrder ? `<span class="badge bg-secondary">Order: ${pm.displayOrder}</span>` : ''}
                            </div>
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-outline-primary btn-sm" onclick="editPaymentMethod(${pm.id})" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </button>
                            </div>
                        `;
                        listContainer.appendChild(listItem);
                    });
                } else {
