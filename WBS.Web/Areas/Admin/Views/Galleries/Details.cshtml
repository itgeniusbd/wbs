@model WBS.Web.Models.Gallery
@{
    ViewData["Title"] = Model.Title;
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Galleries</a></li>
            <li class="breadcrumb-item active">@Model.Title</li>
        </ol>
    </nav>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <!-- Gallery Info -->
    <div class="col-lg-4 mb-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Gallery Info</h5>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.CoverImage))
                {
                    <img src="@Model.CoverImage" class="img-fluid rounded mb-3" alt="@Model.Title" />
                }

                <h4>@Model.Title</h4>
                @if (!string.IsNullOrEmpty(Model.TitleBn))
                {
                    <p class="text-muted">@Model.TitleBn</p>
                }

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p class="mt-3">@Model.Description</p>
                }

                <hr />

                <dl class="row mb-0">
                    <dt class="col-sm-5">Total Images:</dt>
                    <dd class="col-sm-7">
                        <span class="badge bg-info">@Model.Images.Count</span>
                    </dd>

                    <dt class="col-sm-5">Status:</dt>
                    <dd class="col-sm-7">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </dd>

                    <dt class="col-sm-5">Created:</dt>
                    <dd class="col-sm-7">
                        <small>@Model.CreatedAt.ToString("MMM dd, yyyy")</small>
                    </dd>
                </dl>

                <div class="d-grid gap-2 mt-3">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                        <i class="fas fa-edit me-1"></i> Edit Gallery
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Upload Images Section -->
    <div class="col-lg-8 mb-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-cloud-upload-alt me-2"></i>Upload Images</h5>
            </div>
            <div class="card-body">
                <form asp-action="UploadImages" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    
                    <div class="mb-3">
                        <label class="form-label">Select Images <span class="text-danger">*</span></label>
                        <input type="file" name="imageFiles" class="form-control" multiple accept="image/*" required />
                        <small class="form-text text-muted">
                            <i class="fas fa-info-circle me-1"></i>
                            You can select multiple images. They will be uploaded to Cloudinary.
                        </small>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Caption (English)</label>
                            <input type="text" name="caption" class="form-control" placeholder="Optional caption for all images" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Caption (?????)</label>
                            <input type="text" name="captionBn" class="form-control" placeholder="?? ???? ???? ??????? (??????)" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-upload me-1"></i> Upload Images
                    </button>
                </form>
            </div>
        </div>

        <!-- Existing Images -->
        <div class="card mt-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-images me-2"></i>Gallery Images (@Model.Images.Count)</h5>
            </div>
            <div class="card-body">
                @if (Model.Images.Any())
                {
                    <div class="row g-3" id="imageGallery">
                        @foreach (var image in Model.Images)
                        {
                            <div class="col-md-4 col-sm-6">
                                <div class="card h-100">
                                    <img src="@image.ImageUrl" class="card-img-top" alt="@image.Caption" style="height: 200px; object-fit: cover;" />
                                    <div class="card-body p-2">
                                        @if (!string.IsNullOrEmpty(image.Caption))
                                        {
                                            <small class="text-muted d-block">@image.Caption</small>
                                        }
                                        <div class="d-flex justify-content-between align-items-center mt-2">
                                            <small class="text-muted">Order: @image.DisplayOrder</small>
                                            <button type="button" class="btn btn-sm btn-danger" onclick="deleteImage(@image.Id, @Model.Id)">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>No images uploaded yet. Use the form above to add images.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Delete Image Modal -->
<div class="modal fade" id="deleteImageModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this image?</p>
                <p class="text-danger"><i class="fas fa-exclamation-triangle me-1"></i>This action cannot be undone!</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteImageForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deleteImage(imageId, galleryId) {
            document.getElementById('deleteImageForm').action = '@Url.Action("DeleteImage", "Galleries")?id=' + imageId + '&galleryId=' + galleryId;
            new bootstrap.Modal(document.getElementById('deleteImageModal')).show();
        }
    </script>
}
