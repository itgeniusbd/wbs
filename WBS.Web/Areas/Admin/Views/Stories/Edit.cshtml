@model WBS.Web.Models.Story
@{
    ViewData["Title"] = "Edit Success Story";
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Success Stories</a></li>
            <li class="breadcrumb-item active">Edit</li>
        </ol>
    </nav>
</div>

<div class="row">
    <div class="col-lg-10 mx-auto">
        <div class="card">
            <div class="card-header">
                <h4 class="mb-0"><i class="fas fa-edit me-2"></i>Edit Success Story</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CreatedAt" />
                    <input type="hidden" asp-for="FeaturedImage" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <!-- English Fields -->
                    <h5 class="mb-3 text-primary"><i class="fas fa-language me-2"></i>English Content</h5>
                    
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label asp-for="Title" class="form-label">Title <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Slug" class="form-label">URL Slug</label>
                            <input asp-for="Slug" class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="BeneficiaryName" class="form-label">Beneficiary Name</label>
                            <input asp-for="BeneficiaryName" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Location" class="form-label">Location</label>
                            <input asp-for="Location" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Summary" class="form-label">Summary</label>
                        <textarea asp-for="Summary" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Content" class="form-label">Full Story Content</label>
                        <textarea asp-for="Content" class="form-control" rows="8"></textarea>
                    </div>

                    <hr class="my-4" />

                    <!-- Bangla Fields -->
                    <h5 class="mb-3 text-primary"><i class="fas fa-language me-2"></i>বাংলা কন্টেন্ট</h5>
                    
                    <div class="mb-3">
                        <label asp-for="TitleBn" class="form-label">শিরোনাম (বাংলা)</label>
                        <input asp-for="TitleBn" class="form-control" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="BeneficiaryNameBn" class="form-label">সুবিধাভোগীর নাম (বাংলা)</label>
                            <input asp-for="BeneficiaryNameBn" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="LocationBn" class="form-label">স্থান (বাংলা)</label>
                            <input asp-for="LocationBn" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SummaryBn" class="form-label">সংক্ষিপ্ত বিবরণ (বাংলা)</label>
                        <textarea asp-for="SummaryBn" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ContentBn" class="form-label">সম্পূর্ণ গল্প (বাংলা)</label>
                        <textarea asp-for="ContentBn" class="form-control" rows="8"></textarea>
                    </div>

                    <hr class="my-4" />

                    <!-- Media -->
                    <h5 class="mb-3 text-primary"><i class="fas fa-image me-2"></i>Media</h5>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Featured Image</label>
                            @if (!string.IsNullOrEmpty(Model.FeaturedImage))
                            {
                                <div class="mb-2">
                                    <img src="@Model.FeaturedImage" alt="Current Image" class="img-thumbnail" style="max-height: 150px;" />
                                </div>
                            }
                            <input type="file" name="featuredImage" class="form-control" accept="image/*" />
                            <small class="text-muted">Upload new image to replace existing</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="VideoUrl" class="form-label">Video URL (Optional)</label>
                            <input asp-for="VideoUrl" class="form-control" />
                        </div>
                    </div>

                    <hr class="my-4" />

                    <!-- Settings -->
                    <h5 class="mb-3 text-primary"><i class="fas fa-cog me-2"></i>Settings</h5>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                <label asp-for="IsActive" class="form-check-label">Active</label>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="IsFeatured" class="form-check-input" type="checkbox" />
                                <label asp-for="IsFeatured" class="form-check-label">Featured</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-times me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
