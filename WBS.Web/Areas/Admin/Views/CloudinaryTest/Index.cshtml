@{
    ViewData["Title"] = "Cloudinary Upload Test";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-cloud-upload-alt me-2"></i>Cloudinary Upload Test</h2>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-vial me-2"></i>Test Image Upload</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong><i class="fas fa-exclamation-triangle me-2"></i>Error:</strong> @ViewBag.Error
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (ViewBag.Success != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <strong><i class="fas fa-check-circle me-2"></i>Success:</strong> @ViewBag.Success
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>

                        @if (ViewBag.ImageUrl != null)
                        {
                            <div class="mt-3">
                                <h6>Uploaded Image:</h6>
                                <img src="@ViewBag.ImageUrl" alt="Test Upload" class="img-fluid img-thumbnail" style="max-height: 400px;" />
                                <div class="mt-2">
                                    <strong>URL:</strong> <a href="@ViewBag.ImageUrl" target="_blank">@ViewBag.ImageUrl</a>
                                </div>
                            </div>
                        }
                    }

                    <form asp-action="TestUpload" method="post" enctype="multipart/form-data" id="testForm">
                        <div class="mb-3">
                            <label class="form-label"><strong>Select Test Image</strong></label>
                            <input type="file" name="testImage" class="form-control" accept="image/*" required />
                            <small class="form-text text-muted">
                                Select any image to test Cloudinary upload functionality
                            </small>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg" id="uploadBtn">
                                <i class="fas fa-upload me-2"></i>
                                <span id="uploadText">Test Upload</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0"><i class="fas fa-info-circle me-2"></i>Configuration Info</h6>
                </div>
                <div class="card-body">
                    @if (ViewBag.CloudName != null)
                    {
                        <p class="mb-2">
                            <strong>Cloud Name:</strong> @ViewBag.CloudName
                        </p>
                    }
                    @if (ViewBag.HasApiKey != null)
                    {
                        <p class="mb-2">
                            <strong>API Key:</strong> 
                            @if ((bool)ViewBag.HasApiKey)
                            {
                                <span class="badge bg-success">Configured</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Missing</span>
                            }
                        </p>
                    }
                    @if (ViewBag.HasApiSecret != null)
                    {
                        <p class="mb-2">
                            <strong>API Secret:</strong> 
                            @if ((bool)ViewBag.HasApiSecret)
                            {
                                <span class="badge bg-success">Configured</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Missing</span>
                            }
                        </p>
                    }

                    <hr />

                    <h6 class="mt-3 mb-2"><i class="fas fa-book me-2"></i>Troubleshooting Tips:</h6>
                    <ul class="small mb-0">
                        <li>Check your internet connection</li>
                        <li>Verify Cloudinary credentials in appsettings.json</li>
                        <li>Check if firewall is blocking Cloudinary API</li>
                        <li>Review application logs for detailed errors</li>
                        <li>Test with a small image file first</li>
                    </ul>
                </div>
            </div>

            <div class="card shadow mt-3">
                <div class="card-header bg-warning">
                    <h6 class="mb-0"><i class="fas fa-shield-alt me-2"></i>Security Note</h6>
                </div>
                <div class="card-body small">
                    <p class="mb-0">
                        This test page is only accessible to administrators. 
                        API credentials are never displayed for security reasons.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('testForm').addEventListener('submit', function() {
            const uploadBtn = document.getElementById('uploadBtn');
            const uploadText = document.getElementById('uploadText');
            
            uploadBtn.disabled = true;
            uploadText.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Uploading...';
        });
    </script>
}
