@model WBS.Web.Models.SDGProgram
@{
    ViewData["Title"] = "Create SDG Program";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-plus me-2"></i>Create SDG Program</h2>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back to List
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label asp-for="SDGId" class="form-label">SDG *</label>
                        <select asp-for="SDGId" class="form-select" asp-items="ViewBag.SDGs">
                            <option value="">-- Select SDG --</option>
                        </select>
                        <span asp-validation-for="SDGId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Program Title (English) *</label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="TitleBn" class="form-label">Program Title (বাংলা)</label>
                        <input asp-for="TitleBn" class="form-control" style="font-family: 'Noto Sans Bengali', sans-serif;" />
                        <span asp-validation-for="TitleBn" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description (English)</label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DescriptionBn" class="form-label">Description (বাংলা)</label>
                        <textarea asp-for="DescriptionBn" class="form-control" rows="4" style="font-family: 'Noto Sans Bengali', sans-serif;"></textarea>
                        <span asp-validation-for="DescriptionBn" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Featured Image</label>
                        <input type="file" name="featuredImage" class="form-control" accept="image/*" />
                        <small class="text-muted">Recommended size: 800x600px</small>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="DisplayOrder" class="form-label">Display Order</label>
                            <input asp-for="DisplayOrder" type="number" class="form-control" value="0" />
                            <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="IsActive" class="form-label">Status</label>
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                                <label asp-for="IsActive" class="form-check-label">Active</label>
                            </div>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="IsFeatured" class="form-label">Featured</label>
                            <div class="form-check form-switch">
                                <input asp-for="IsFeatured" class="form-check-input" type="checkbox" />
                                <label asp-for="IsFeatured" class="form-check-label">Show on Home Page</label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsRohingyaProgram" class="form-check-input" type="checkbox" />
                            <label asp-for="IsRohingyaProgram" class="form-check-label">
                                <strong>This is a Rohingya Program</strong> / <span style="font-family: 'Noto Sans Bengali', sans-serif;">এটি একটি রোহিঙ্গা কর্মসূচি</span>
                            </label>
                        </div>
                        <small class="text-muted">Check this if this program should appear on the Rohingya Response page</small>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i>Create Program
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Information</h5>
            </div>
            <div class="card-body">
                <h6>What is an SDG Program?</h6>
                <p class="small">An SDG Program is a collection of related events/projects under a specific SDG goal.</p>
                
                <h6 class="mt-3">Hierarchy:</h6>
                <ul class="small">
                    <li><strong>SDG</strong> (e.g., No Poverty)</li>
                    <li>→ <strong>Program</strong> (e.g., Poverty Alleviation)</li>
                    <li>&nbsp;&nbsp;&nbsp;&nbsp;→ <strong>Events</strong> (e.g., Food Distribution)</li>
                </ul>

                <div class="alert alert-warning mt-3 mb-0">
                    <small><i class="fas fa-exclamation-triangle me-1"></i>After creating a program, you can add events to it from the "Program Events" menu.</small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
