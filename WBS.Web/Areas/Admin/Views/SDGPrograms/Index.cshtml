@model List<WBS.Web.Models.SDGProgram>
@{
    ViewData["Title"] = "SDG Programs";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="fas fa-sitemap me-2"></i>@(ViewBag.FilterRohingya == true ? "Rohingya Programs" : "SDG Programs")</h2>
        @if (ViewBag.FilterRohingya == true)
        {
            <p class="text-muted mb-0">
                <i class="fas fa-filter me-1"></i> Showing only Rohingya Programs
                <a href="/admin/sdgprograms" class="ms-2 btn btn-sm btn-outline-secondary">
                    <i class="fas fa-times me-1"></i> Clear Filter
                </a>
            </p>
        }
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>Create New Program
    </a>
</div>

@if (Model.Any())
{
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>SDG</th>
                            <th>Program Title</th>
                            <th>Events Count</th>
                            <th>Order</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var program in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(program.FeaturedImage))
                                    {
                                        <img src="@program.FeaturedImage" alt="@program.Title" style="width: 60px; height: 60px; object-fit: cover; border-radius: 8px;" />
                                    }
                                    else
                                    {
                                        <div class="bg-secondary d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; border-radius: 8px;">
                                            <i class="fas fa-image text-white"></i>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="badge" style="background-color: @program.SDG?.Color; color: white;">
                                        SDG @program.SDG?.Number
                                    </span>
                                    <br />
                                    <small>@program.SDG?.Name</small>
                                </td>
                                <td>
                                    <strong>@program.Title</strong>
                                    @if (!string.IsNullOrEmpty(program.TitleBn))
                                    {
                                        <br />
                                        <small class="text-muted">@program.TitleBn</small>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-info">
                                        <i class="fas fa-calendar-alt me-1"></i>
                                        @program.Events.Count event(s)
                                    </span>
                                </td>
                                <td>@program.DisplayOrder</td>
                                <td>
                                    @if (program.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                    <br />
                                    @if (program.IsFeatured)
                                    {
                                        <span class="badge bg-warning text-dark mt-1">
                                            <i class="fas fa-star me-1"></i>Featured
                                        </span>
                                    }
                                    @if (program.IsRohingyaProgram)
                                    {
                                        <br />
                                        <span class="badge bg-primary mt-1">
                                            <i class="fas fa-hands-helping me-1"></i>Rohingya
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@program.Id" class="btn btn-sm btn-primary">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@program.Id" method="post" class="d-inline" 
                                              onsubmit="return confirm('Are you sure you want to delete this program? This will also affect all related events.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>No SDG Programs found. 
        <a asp-action="Create" class="alert-link">Create the first program</a>.
    </div>
}
