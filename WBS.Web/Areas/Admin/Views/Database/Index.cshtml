@{
    ViewData["Title"] = "Database Management";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-database me-2"></i>Database Management
                    </h4>
                </div>
                <div class="card-body">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <h5 class="mb-3">Bengali Text Encoding Fix</h5>
                    <p class="text-muted">
                        If you see <code>?</code> marks instead of Bengali text, click the button below to fix the encoding issue.
                        This will update all Bengali text fields with proper Unicode values.
                    </p>

                    <div class="mb-4">
                        <form asp-action="FixBengaliEncoding" method="post" onsubmit="return confirm('Are you sure you want to fix Bengali encoding? This will update all Bengali text fields.');">
                            <button type="submit" class="btn btn-primary btn-lg me-2">
                                <i class="fas fa-wrench me-2"></i>Fix All Bengali Encoding
                            </button>
                        </form>
                    </div>

                    <div class="mb-4">
                        <h5 class="mb-3">Fix SDG Bengali Text</h5>
                        <p class="text-muted">
                            If SDG page shows <code>?</code> marks instead of Bengali names, click this button to fix SDG Bengali text specifically.
                        </p>
                        <form asp-action="FixSDGBengaliText" method="post" onsubmit="return confirm('Fix SDG Bengali text?');">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="fas fa-globe me-2"></i>Fix SDG Bengali Text
                            </button>
                        </form>
                    </div>

                    <hr />

                    <h5 class="mb-3">Check Current Encoding</h5>
                    <button type="button" class="btn btn-info" onclick="checkEncoding()">
                        <i class="fas fa-search me-2"></i>Check Encoding Status
                    </button>

                    <div id="encodingResults" class="mt-3" style="display: none;">
                        <h6>Encoding Status:</h6>
                        <div class="table-responsive">
                            <table class="table table-striped" id="encodingTable">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Name (English)</th>
                                        <th>Name (বাংলা)</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle me-2"></i>Bengali Text Guidelines
                    </h5>
                </div>
                <div class="card-body">
                    <h6>How to add Bengali text correctly:</h6>
                    <ol>
                        <li>Always use Unicode Bengali characters</li>
                        <li>Make sure your database columns use <code>NVARCHAR</code> type</li>
                        <li>When inserting data via SQL, prefix strings with <code>N</code>:
                            <pre class="bg-light p-2"><code>INSERT INTO Table (NameBn) VALUES (N'????? ??????');</code></pre>
                        </li>
                        <li>In C# code, strings are automatically Unicode</li>
                    </ol>

                    <h6 class="mt-3">Common Bengali Translations:</h6>
                    <div class="row">
                        <div class="col-md-6">
                            <ul class="list-unstyled">
                                <li><strong>Lillah:</strong> লিল্লাহ</li>
                                <li><strong>Zakat:</strong> যাকাত</li>
                                <li><strong>Sadaqah:</strong> সদাকাহ</li>
                                <li><strong>Donate Now:</strong> এখন দান করুন</li>
                                <li><strong>Learn More:</strong> আরও জানুন</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <ul class="list-unstyled">
                                <li><strong>Home:</strong> বাড়ি</li>
                                <li><strong>About Us:</strong> আমাদের সম্পর্কে</li>
                                <li><strong>Contact:</strong> যোগাযোগ</li>
                                <li><strong>Activities:</strong> কার্যক্রম</li>
                                <li><strong>Get Involved:</strong> জড়িত হন</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function checkEncoding() {
            fetch('@Url.Action("CheckEncoding", "Database")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const tbody = document.querySelector('#encodingTable tbody');
                    tbody.innerHTML = '';
                    
                    data.data.forEach(item => {
                        const row = tbody.insertRow();
                        row.innerHTML = `
                            <td>${item.id}</td>
                            <td>${item.name}</td>
                            <td class="bengali-text">${item.nameBn}</td>
                            <td>${item.encodingCheck}</td>
                        `;
                    });
                    
                    document.getElementById('encodingResults').style.display = 'block';
                } else {
                    alert('Error: ' + data.error);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred while checking encoding');
            });
        }
    </script>
}
