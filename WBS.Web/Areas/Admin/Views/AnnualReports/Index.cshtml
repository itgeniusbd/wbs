@model IEnumerable<WBS.Web.Models.AnnualReport>

@{
    ViewData["Title"] = "Annual Reports";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Annual Reports</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>Add New Report
    </a>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Year</th>
                            <th>Title</th>
                            <th>Cover Image</th>
                            <th>PDF</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var report in Model)
                        {
                            <tr>
                                <td><strong>@report.Year</strong></td>
                                <td>
                                    <div>@report.Title</div>
                                    @if (!string.IsNullOrEmpty(report.TitleBn))
                                    {
                                        <small class="text-muted bangla-text">@report.TitleBn</small>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(report.CoverImage))
                                    {
                                        <img src="@report.CoverImage" alt="Cover" style="height: 50px; width: auto;" class="rounded" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">No image</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(report.FileUrl))
                                    {
                                        <a asp-action="ViewPDF" asp-route-id="@report.Id" target="_blank" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i> View PDF
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No PDF</span>
                                    }
                                </td>
                                <td>
                                    @if (report.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@report.Id" class="btn btn-sm btn-warning">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@report.Id" class="btn btn-sm btn-danger">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                No annual reports have been added yet. Click "Add New Report" to create one.
            </div>
        }
    </div>
</div>
