@model WBS.Web.Models.AnnualReport

@{
    ViewData["Title"] = "Add New Annual Report";
}

<div class="mb-4">
    <h2>Add New Annual Report</h2>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Annual Reports</a></li>
            <li class="breadcrumb-item active">Create</li>
        </ol>
    </nav>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Year" class="form-label">Year</label>
                    <input asp-for="Year" class="form-control" type="number" min="2000" max="2100" />
                    <span asp-validation-for="Year" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="IsActive" class="form-label d-block">Status</label>
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label">Active</label>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Title" class="form-label">Title (English)</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="TitleBn" class="form-label">Title (Bengali)</label>
                    <input asp-for="TitleBn" class="form-control bangla-text" style="font-family: 'Noto Sans Bengali', sans-serif;" />
                    <span asp-validation-for="TitleBn" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Description (English)</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DescriptionBn" class="form-label">Description (Bengali)</label>
                <textarea asp-for="DescriptionBn" class="form-control bangla-text" rows="3" style="font-family: 'Noto Sans Bengali', sans-serif;"></textarea>
                <span asp-validation-for="DescriptionBn" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">PDF Document <span class="text-danger">*</span></label>
                <input type="file" name="pdfFile" id="pdfFile" class="form-control" accept=".pdf" required />
                <small class="text-muted">Upload the annual report PDF document</small>
                @if (ViewData.ModelState.ContainsKey("pdfFile") && ViewData.ModelState["pdfFile"]!.Errors.Count > 0)
                {
                    <div class="text-danger">@ViewData.ModelState["pdfFile"]!.Errors[0].ErrorMessage</div>
                }
            </div>

            <div class="mb-3">
                <label class="form-label">Cover Image (Optional)</label>
                <input type="file" name="coverImageFile" class="form-control" accept="image/*" />
                <small class="text-muted">Upload a cover image for the annual report (recommended size: 800x1000px)</small>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2"></i>Save
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-times me-2"></i>Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
