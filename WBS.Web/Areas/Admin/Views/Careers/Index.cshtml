@model IEnumerable<WBS.Web.Models.Career>

@{
    ViewData["Title"] = "Manage Careers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Career Postings</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>Add New Career
    </a>
</div>

@if (Model.Any())
{
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Department</th>
                            <th>Location</th>
                            <th>Job Type</th>
                            <th>Deadline</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var career in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@career.Title</strong>
                                    @if (!string.IsNullOrEmpty(career.TitleBn))
                                    {
                                        <br /><small class="text-muted bangla-text">@career.TitleBn</small>
                                    }
                                </td>
                                <td>@career.Department</td>
                                <td>@career.Location</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(career.JobType))
                                    {
                                        <span class="badge bg-info">@career.JobType</span>
                                    }
                                </td>
                                <td>
                                    @if (career.Deadline.HasValue)
                                    {
                                        <span class="@(career.Deadline.Value < DateTime.UtcNow ? "text-danger" : "")">
                                            @career.Deadline.Value.ToString("MMM dd, yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (career.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group">
                                        <a href="/career/@career.Slug" target="_blank" class="btn btn-sm btn-outline-info" title="View">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@career.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@career.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>No career postings found. Click "Add New Career" to create one.
    </div>
}
