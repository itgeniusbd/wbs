@{
    ViewData["Title"] = "Notification Testing";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-vial me-2"></i>SMS & Email Testing</h2>
    <a asp-action="Templates" class="btn btn-primary">
        <i class="fas fa-file-alt me-2"></i>Manage Templates
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show">
        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Warning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fas fa-times-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="alert alert-info">
    <i class="fas fa-info-circle me-2"></i>
    <strong>Note:</strong> Make sure you have configured SMS and Email settings in <code>appsettings.json</code> 
    and set <code>Enabled: true</code> before testing. Check <code>SMS_EMAIL_SETUP.md</code> for configuration guide.
</div>

<div class="row">
    <!-- Test SMS -->
    <div class="col-md-6 mb-4">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="fas fa-sms me-2"></i>Test SMS</h5>
            </div>
            <div class="card-body">
                <form asp-action="SendTestSms" method="post">
                    <div class="mb-3">
                        <label class="form-label">Phone Number *</label>
                        <input type="text" name="phoneNumber" class="form-control" placeholder="01712345678" required />
                        <small class="text-muted">Format: 01XXXXXXXXX (Bangladesh only)</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Message (Optional)</label>
                        <textarea name="message" class="form-control" rows="3" placeholder="Leave empty for default test message"></textarea>
                    </div>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-paper-plane me-2"></i>Send Test SMS
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Test Email -->
    <div class="col-md-6 mb-4">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-envelope me-2"></i>Test Email</h5>
            </div>
            <div class="card-body">
                <form asp-action="SendTestEmail" method="post">
                    <div class="mb-3">
                        <label class="form-label">Email Address *</label>
                        <input type="email" name="email" class="form-control" placeholder="test@example.com" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Subject (Optional)</label>
                        <input type="text" name="subject" class="form-control" placeholder="Leave empty for default" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Message (Optional)</label>
                        <textarea name="message" class="form-control" rows="3" placeholder="Leave empty for default test message"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-paper-plane me-2"></i>Send Test Email
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Test Donation Receipt -->
<div class="card">
    <div class="card-header bg-warning">
        <h5 class="mb-0"><i class="fas fa-receipt me-2"></i>Test Donation Receipt Notification</h5>
    </div>
    <div class="card-body">
        <p class="text-muted">Test the actual notification that donors receive after making a donation.</p>
        <form asp-action="SendTestDonationReceipt" method="post">
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="form-label">Phone Number</label>
                    <input type="text" name="phoneNumber" class="form-control" placeholder="01712345678" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" name="email" class="form-control" placeholder="donor@example.com" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Donor Name</label>
                    <input type="text" name="donorName" class="form-control" placeholder="Test Donor" value="Test Donor" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Amount (?)</label>
                    <input type="number" name="amount" class="form-control" value="1000" step="0.01" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Donation Type</label>
                <select name="donationTypeId" class="form-select">
                    <option value="">-- Select Donation Type --</option>
                    @if (ViewBag.DonationTypes != null)
                    {
                        foreach (var item in ViewBag.DonationTypes)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
            </div>
            <small class="text-muted d-block mb-3">Provide at least one contact method (phone or email)</small>
            <button type="submit" class="btn btn-warning">
                <i class="fas fa-file-invoice me-2"></i>Send Test Receipt
            </button>
        </form>
    </div>
</div>

<!-- Configuration Status -->
<div class="card mt-4">
    <div class="card-header bg-info text-white">
        <h5 class="mb-0"><i class="fas fa-cog me-2"></i>Configuration Guide</h5>
    </div>
    <div class="card-body">
        <h6>SMS Configuration (Greenweb BD)</h6>
        <ol>
            <li>Get API Token from: <a href="https://gwb.li/token" target="_blank">https://gwb.li/token</a></li>
            <li>Add to appsettings.json:
                <pre class="bg-light p-2 mt-2"><code>"GreenwebSms": {
  "Enabled": true,
  "ApiToken": "your-token-here"
}</code></pre>
            </li>
            <li>Test the integration using the form above</li>
        </ol>

        <hr />

        <h6>Email Configuration</h6>
        <ol>
            <li>For Gmail: Enable 2FA and generate App Password from <a href="https://myaccount.google.com/apppasswords" target="_blank">here</a></li>
            <li>Add to appsettings.json:
                <pre class="bg-light p-2 mt-2"><code>"EmailSettings": {
  "Enabled": true,
  "SmtpServer": "smtp.gmail.com",
  "SmtpPort": 587,
  "FromEmail": "your-email@gmail.com",
  "FromName": "WBS Foundation",
  "Username": "your-email@gmail.com",
  "Password": "your-16-char-app-password",
  "EnableSsl": true
}</code></pre>
            </li>
            <li>Test using the email form above</li>
        </ol>

        <hr />

        <div class="alert alert-warning mb-0">
            <strong>Important:</strong> Check the <code>Output</code> window or log files for detailed error messages if notifications fail.
            The system will log all SMS and Email attempts with success/failure status.
        </div>
    </div>
</div>
