@model List<WBS.Web.Models.NotificationTemplate>
@{
    ViewData["Title"] = "SMS & Email Templates";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-file-alt me-2"></i>SMS & Email Templates</h2>
    <div>
        <a asp-action="SmsLogs" class="btn btn-info text-white">
            <i class="fas fa-history me-2"></i>SMS Logs
        </a>
        <a asp-action="TestNotifications" class="btn btn-secondary">
            <i class="fas fa-vial me-2"></i>Test Notifications
        </a>
        <a asp-action="CreateTemplate" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Create Template
        </a>
    </div>
</div>

<!-- SMS Balance Display -->
<div class="alert alert-success d-flex justify-content-between align-items-center mb-3">
    <div>
        <i class="fas fa-sms me-2"></i>
        <strong>SMS Balance:</strong> 
        <span class="fs-5 ms-2">@ViewBag.SmsBalance</span> SMS
        @if (ViewBag.LastUpdated != null)
        {
            <small class="text-muted ms-3">
                <i class="fas fa-clock me-1"></i>
                Last Updated: @(((DateTime)ViewBag.LastUpdated).ToString("dd MMM yyyy, hh:mm tt"))
            </small>
        }
    </div>
    <a href="/admin/settings" class="btn btn-sm btn-outline-success">
        <i class="fas fa-cog me-1"></i>Update Balance
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="alert alert-info">
    <i class="fas fa-info-circle me-2"></i>
    <strong>Available Placeholders:</strong> {DonorName}, {Amount}, {DonationType}, {TransactionId}, {Date}
</div>

<!-- SMS Templates -->
<div class="card mb-4">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0"><i class="fas fa-sms me-2"></i>SMS Templates</h5>
    </div>
    <div class="card-body">
        <div class="row">
            @foreach (var template in Model.Where(t => t.TemplateType == "SMS"))
            {
                <div class="col-md-6 mb-3">
                    <div class="card @(template.IsDefault ? "border-primary" : "")">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@template.Name</strong>
                                @if (template.IsDefault)
                                {
                                    <span class="badge bg-primary ms-2">Default</span>
                                }
                                @if (!template.IsActive)
                                {
                                    <span class="badge bg-secondary ms-2">Inactive</span>
                                }
                            </div>
                            <div class="btn-group">
                                <a asp-action="EditTemplate" asp-route-id="@template.Id" class="btn btn-sm btn-primary">
                                    <i class="fas fa-edit"></i>
                                </a>
                                @if (!template.IsDefault)
                                {
                                    <form asp-action="DeleteTemplate" asp-route-id="@template.Id" method="post" class="d-inline" 
                                          onsubmit="return confirm('Are you sure you want to delete this template?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                        <div class="card-body">
                            @if (template.DonationType != null)
                            {
                                <p class="text-muted mb-2">
                                    <small><i class="fas fa-tag me-1"></i>@template.DonationType.Name</small>
                                </p>
                            }
                            <div class="bg-light p-3 rounded" style="font-family: monospace; font-size: 13px;">
                                @template.SmsContent
                            </div>
                            <small class="text-muted mt-2 d-block">
                                Length: @(template.SmsContent?.Length ?? 0) characters
                            </small>
                        </div>
                    </div>
                </div>
            }
            
            @if (!Model.Any(t => t.TemplateType == "SMS"))
            {
                <div class="col-12">
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>No SMS templates found. 
                        <a asp-action="CreateTemplate" class="alert-link">Create one now</a>.
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Email Templates -->
<div class="card">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="fas fa-envelope me-2"></i>Email Templates</h5>
    </div>
    <div class="card-body">
        @foreach (var template in Model.Where(t => t.TemplateType == "Email"))
        {
            <div class="card mb-3 @(template.IsDefault ? "border-primary" : "")">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <strong>@template.Name</strong>
                        @if (template.IsDefault)
                        {
                            <span class="badge bg-primary ms-2">Default</span>
                        }
                        @if (!template.IsActive)
                        {
                            <span class="badge bg-secondary ms-2">Inactive</span>
                        }
                    </div>
                    <div class="btn-group">
                        <a asp-action="EditTemplate" asp-route-id="@template.Id" class="btn btn-sm btn-primary">
                            <i class="fas fa-edit"></i>
                        </a>
                        @if (!template.IsDefault)
                        {
                            <form asp-action="DeleteTemplate" asp-route-id="@template.Id" method="post" class="d-inline" 
                                  onsubmit="return confirm('Are you sure you want to delete this template?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        }
                    </div>
                </div>
                <div class="card-body">
                    @if (template.DonationType != null)
                    {
                        <p class="text-muted mb-2">
                            <small><i class="fas fa-tag me-1"></i>@template.DonationType.Name</small>
                        </p>
                    }
                    <div class="mb-3">
                        <strong>Subject:</strong>
                        <div class="bg-light p-2 rounded mt-1">
                            @template.EmailSubject
                        </div>
                    </div>
                    <div>
                        <strong>Email Content:</strong>
                        <div class="bg-light p-3 rounded mt-1" style="max-height: 300px; overflow-y: auto;">
                            @Html.Raw(template.EmailContent)
                        </div>
                    </div>
                </div>
            </div>
        }
        
        @if (!Model.Any(t => t.TemplateType == "Email"))
        {
            <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle me-2"></i>No Email templates found. 
                <a asp-action="CreateTemplate" class="alert-link">Create one now</a>.
            </div>
        }
    </div>
</div>
