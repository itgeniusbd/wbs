@model WBS.Web.Models.SDG
@{
    ViewData["Title"] = "Delete SDG";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row mb-3">
        <div class="col-12">
            <h2 class="text-danger">
                <i class="fas fa-trash me-2"></i>Delete SDG
            </h2>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i>Confirm Deletion
                    </h5>
                </div>
                <div class="card-body">
                    <p class="lead">Are you sure you want to delete this SDG?</p>

                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        <strong>Warning:</strong> This action cannot be undone. All related data will be affected.
                    </div>

                    <dl class="row">
                        <dt class="col-sm-3">Number</dt>
                        <dd class="col-sm-9">
                            <span class="badge" style="background-color: @Model.Color; font-size: 1.2rem;">
                                @Model.Number
                            </span>
                        </dd>

                        <dt class="col-sm-3">Name (EN)</dt>
                        <dd class="col-sm-9">@Model.Name</dd>

                        <dt class="col-sm-3">Name (BN)</dt>
                        <dd class="col-sm-9">@Model.NameBn</dd>

                        <dt class="col-sm-3">Display Order</dt>
                        <dd class="col-sm-9">@Model.DisplayOrder</dd>

                        <dt class="col-sm-3">Related Sectors</dt>
                        <dd class="col-sm-9">
                            @if (Model.Sectors.Any())
                            {
                                <span class="badge bg-info">@Model.Sectors.Count sector(s)</span>
                                <ul class="mt-2">
                                    @foreach (var sector in Model.Sectors)
                                    {
                                        <li>@sector.Name</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <span class="text-muted">No sectors linked</span>
                            }
                        </dd>

                        @if (!string.IsNullOrEmpty(Model.Image))
                        {
                            <dt class="col-sm-3">Image</dt>
                            <dd class="col-sm-9">
                                <img src="@Model.Image" alt="@Model.Name" style="width: 150px; height: 150px; object-fit: cover; border-radius: 5px;" />
                            </dd>
                        }

                        <dt class="col-sm-3">Status</dt>
                        <dd class="col-sm-9">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </dd>
                    </dl>

                    <hr />

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash me-1"></i>Delete Permanently
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow border-warning">
                <div class="card-header bg-warning">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle me-2"></i>Important Notes
                    </h5>
                </div>
                <div class="card-body">
                    <ul class="small">
                        <li>Deleting this SDG will remove it from the website</li>
                        <li>Any sectors linked to this SDG will become unlinked</li>
                        <li>The SDG image will be permanently deleted</li>
                        <li>This action cannot be reversed</li>
                    </ul>

                    <hr />

                    <h6>Alternative Actions</h6>
                    <ul class="small">
                        <li>Instead of deleting, you can <strong>deactivate</strong> the SDG by editing it</li>
                        <li>Deactivated SDGs won't show on the website but data is preserved</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
