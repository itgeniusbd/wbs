@model IEnumerable<WBS.Web.Models.AboutSDG>

@{
    ViewData["Title"] = "Manage About SDGs";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 mb-0">About SDGs Management</h1>
            <p class="text-muted">Manage About SDGs page content</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <div class="row align-items-center">
                <div class="col">
                    <h5 class="mb-0">About SDGs Entries</h5>
                </div>
                <div class="col-auto">
                    <a href="@Url.Action("Create")" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Add New Content
                    </a>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Image</th>
                                <th>Title</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th>Updated</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.FeaturedImage))
                                        {
                                            <img src="@item.FeaturedImage" alt="@item.Title" 
                                                 class="img-thumbnail" style="width: 80px; height: 60px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="bg-light d-flex align-items-center justify-content-center" 
                                                 style="width: 80px; height: 60px;">
                                                <i class="fas fa-image text-muted"></i>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <strong>@item.Title</strong>
                                        @if (!string.IsNullOrEmpty(item.TitleBn))
                                        {
                                            <br /><small class="text-muted">@item.TitleBn</small>
                                        }
                                    </td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <small>@item.CreatedAt.ToString("dd MMM yyyy")</small>
                                    </td>
                                    <td>
                                        @if (item.UpdatedAt.HasValue)
                                        {
                                            <small>@item.UpdatedAt.Value.ToString("dd MMM yyyy")</small>
                                        }
                                        else
                                        {
                                            <small class="text-muted">-</small>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a href="@Url.Action("Edit", new { id = item.Id })" 
                                               class="btn btn-outline-primary" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            
                                            <form asp-action="ToggleActive" asp-route-id="@item.Id" 
                                                  method="post" style="display: inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-warning" 
                                                        title="@(item.IsActive ? "Deactivate" : "Activate")">
                                                    <i class="fas fa-@(item.IsActive ? "eye-slash" : "eye")"></i>
                                                </button>
                                            </form>
                                            
                                            <button type="button" class="btn btn-outline-danger" 
                                                    onclick="confirmDelete(@item.Id, '@item.Title')" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-globe fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No About SDGs content found.</p>
                    <a href="@Url.Action("Create")" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Add First Content
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<form id="deleteForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        function confirmDelete(id, title) {
            if (confirm('Are you sure you want to delete "' + title + '"?')) {
                var form = document.getElementById('deleteForm');
                form.action = '@Url.Action("Delete")/' + id;
                form.submit();
            }
        }
    </script>
}
