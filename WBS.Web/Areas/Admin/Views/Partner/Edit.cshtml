@model WBS.Web.Models.Partner

@{
    ViewData["Title"] = "Edit Partner";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="fas fa-edit me-2"></i>Edit Partner
    </h1>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back to List
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Logo" />

            <div class="row">
                <!-- English Name -->
                <div class="col-md-6 mb-3">
                    <label asp-for="Name" class="form-label">Partner Name (English) <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <!-- Bangla Name -->
                <div class="col-md-6 mb-3">
                    <label asp-for="NameBn" class="form-label">Partner Name (বাংলা)</label>
                    <input asp-for="NameBn" class="form-control" style="font-family: 'Noto Sans Bengali', sans-serif;" />
                    <span asp-validation-for="NameBn" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <!-- Website -->
                <div class="col-md-6 mb-3">
                    <label asp-for="Website" class="form-label">Website URL</label>
                    <input asp-for="Website" class="form-control" type="url" />
                    <span asp-validation-for="Website" class="text-danger"></span>
                </div>

                <!-- Logo -->
                <div class="col-md-6 mb-3">
                    <label for="logoFile" class="form-label">Logo</label>
                    @if (!string.IsNullOrEmpty(Model.Logo))
                    {
                        <div class="mb-2">
                            <img src="@Model.Logo" alt="Current logo" class="img-thumbnail" style="max-height: 100px;" />
                        </div>
                    }
                    <input type="file" id="logoFile" name="logoFile" class="form-control" accept="image/*" />
                    <small class="text-muted">Leave empty to keep current logo</small>
                </div>
            </div>

            <hr class="my-4" />
            <h5 class="mb-3"><i class="fas fa-share-alt me-2"></i>Social Media Links</h5>

            <div class="row">
                <!-- Facebook -->
                <div class="col-md-6 mb-3">
                    <label asp-for="FacebookUrl" class="form-label"><i class="fab fa-facebook text-primary me-2"></i>Facebook URL</label>
                    <input asp-for="FacebookUrl" class="form-control" type="url" />
                    <span asp-validation-for="FacebookUrl" class="text-danger"></span>
                </div>

                <!-- Twitter -->
                <div class="col-md-6 mb-3">
                    <label asp-for="TwitterUrl" class="form-label"><i class="fab fa-twitter text-info me-2"></i>Twitter URL</label>
                    <input asp-for="TwitterUrl" class="form-control" type="url" />
                    <span asp-validation-for="TwitterUrl" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <!-- LinkedIn -->
                <div class="col-md-6 mb-3">
                    <label asp-for="LinkedInUrl" class="form-label"><i class="fab fa-linkedin text-primary me-2"></i>LinkedIn URL</label>
                    <input asp-for="LinkedInUrl" class="form-control" type="url" />
                    <span asp-validation-for="LinkedInUrl" class="text-danger"></span>
                </div>

                <!-- Instagram -->
                <div class="col-md-6 mb-3">
                    <label asp-for="InstagramUrl" class="form-label"><i class="fab fa-instagram text-danger me-2"></i>Instagram URL</label>
                    <input asp-for="InstagramUrl" class="form-control" type="url" />
                    <span asp-validation-for="InstagramUrl" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <!-- YouTube -->
                <div class="col-md-6 mb-3">
                    <label asp-for="YouTubeUrl" class="form-label"><i class="fab fa-youtube text-danger me-2"></i>YouTube URL</label>
                    <input asp-for="YouTubeUrl" class="form-control" type="url" />
                    <span asp-validation-for="YouTubeUrl" class="text-danger"></span>
                </div>
            </div>

            <hr class="my-4" />

            <div class="row">
                <!-- Display Order -->
                <div class="col-md-6 mb-3">
                    <label asp-for="DisplayOrder" class="form-label">Display Order</label>
                    <input asp-for="DisplayOrder" type="number" class="form-control" min="0" />
                    <small class="form-text text-muted">Lower numbers appear first</small>
                    <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                </div>

                <!-- Is Active -->
                <div class="col-md-6 mb-3">
                    <div class="form-check mt-4">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label">
                            Active
                        </label>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2"></i>Update Partner
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-times me-2"></i>Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
