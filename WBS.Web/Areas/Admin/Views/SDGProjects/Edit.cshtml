@model WBS.Web.Models.SDGProject
@{
    ViewData["Title"] = "Edit SDG Project";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row mb-3">
        <div class="col-12">
            <h2>
                <i class="fas fa-edit me-2"></i>Edit SDG Project (Event)
            </h2>
        </div>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedAt" />
        <input type="hidden" asp-for="FeaturedImage" />
        
        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow mb-3">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Project Information</h5>
                    </div>
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="SDGId" class="form-label">Select SDG *</label>
                            <select asp-for="SDGId" class="form-select" asp-items="ViewBag.SDGs" id="sdgDropdown">
                                <option value="">-- Select SDG --</option>
                            </select>
                            <span asp-validation-for="SDGId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SDGProgramId" class="form-label">Select Program *</label>
                            <select asp-for="SDGProgramId" class="form-select" asp-items="ViewBag.Programs" id="programDropdown">
                                <option value="">-- First Select SDG --</option>
                            </select>
                            <span asp-validation-for="SDGProgramId" class="text-danger"></span>
                            <small class="text-muted">Select a program under the chosen SDG</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">Project Title (English) *</label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Project Title (বাংলা)</label>
                            <input asp-for="TitleBn" class="form-control" placeholder="প্রকল্পের নাম লিখুন" style="font-family: 'Noto Sans Bengali', sans-serif;" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description (English)</label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Description (বিবরণ)</label>
                            <textarea asp-for="DescriptionBn" class="form-control" rows="4" 
                                      placeholder="প্রকল্পের বিবরণ লিখুন..." style="font-family: 'Noto Sans Bengali', sans-serif;"></textarea>
                        </div>
                    </div>
                </div>

                <div class="card shadow mb-3">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">Location Details</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="District" class="form-label">District (English)</label>
                                <input asp-for="District" class="form-control" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">District (জেলা)</label>
                                <input asp-for="DistrictBn" class="form-control" placeholder="জেলার নাম লিখুন" style="font-family: 'Noto Sans Bengali', sans-serif;" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Thana" class="form-label">Thana (English)</label>
                                <input asp-for="Thana" class="form-control" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Thana (থানা)</label>
                                <input asp-for="ThanaBn" class="form-control" placeholder="থানার নাম লিখুন" style="font-family: 'Noto Sans Bengali', sans-serif;" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Union" class="form-label">Union (English)</label>
                                <input asp-for="Union" class="form-control" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Union (ইউনিয়ন)</label>
                                <input asp-for="UnionBn" class="form-control" placeholder="ইউনিয়নের নাম লিখুন" style="font-family: 'Noto Sans Bengali', sans-serif;" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Village" class="form-label">Village (English)</label>
                                <input asp-for="Village" class="form-control" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Village (গ্রাম)</label>
                                <input asp-for="VillageBn" class="form-control" placeholder="গ্রামের নাম লিখুন" style="font-family: 'Noto Sans Bengali', sans-serif;" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card shadow mb-3">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Images</h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(Model.FeaturedImage))
                        {
                            <div class="mb-3">
                                <label class="form-label">Current Featured Image</label>
                                <div>
                                    <img src="@Model.FeaturedImage" alt="Featured" class="img-thumbnail" style="max-height: 200px;" />
                                </div>
                            </div>
                        }

                        <div class="mb-3">
                            <label for="featuredImage" class="form-label">Change Featured Image</label>
                            <input type="file" class="form-control" id="featuredImage" name="featuredImage" accept="image/*" />
                            <small class="text-muted">Leave empty to keep current image</small>
                        </div>

                        @if (Model.Images.Any())
                        {
                            <div class="mb-3">
                                <label class="form-label">Current Gallery Images</label>
                                <div class="row g-2">
                                    @foreach (var image in Model.Images.OrderBy(i => i.DisplayOrder))
                                    {
                                        <div class="col-md-3">
                                            <div class="position-relative">
                                                <img src="@image.ImageUrl" class="img-thumbnail" style="width: 100%; height: 150px; object-fit: cover;" />
                                                <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 m-1" 
                                                        onclick="deleteImage(@image.Id)">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <div class="mb-3">
                            <label for="projectImages" class="form-label">Add More Images</label>
                            <input type="file" class="form-control" id="projectImages" name="projectImages" 
                                   accept="image/*" multiple />
                            <small class="text-muted">Upload additional images for gallery</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow mb-3">
                    <div class="card-header bg-warning">
                        <h5 class="mb-0">Project Details</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="BeneficiaryCount" class="form-label">Beneficiary Count *</label>
                            <input asp-for="BeneficiaryCount" type="number" class="form-control" min="0" />
                            <span asp-validation-for="BeneficiaryCount" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="StartDate" class="form-label">Start Date</label>
                            <input asp-for="StartDate" type="date" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="EndDate" class="form-label">End Date</label>
                            <input asp-for="EndDate" type="date" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="DisplayOrder" class="form-label">Display Order</label>
                            <input asp-for="DisplayOrder" type="number" class="form-control" />
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label">
                                Active (Show on website)
                            </label>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="IsFeatured" class="form-check-input" type="checkbox" />
                            <label asp-for="IsFeatured" class="form-check-label">
                                Featured Project
                            </label>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="IsRohingyaEvent" class="form-check-input" type="checkbox" />
                            <label asp-for="IsRohingyaEvent" class="form-check-label">
                                <strong>Rohingya Event</strong> / <span style="font-family: 'Noto Sans Bengali', sans-serif;">রোহিঙ্গা ইভেন্ট</span>
                            </label>
                            <small class="d-block text-muted">Check if this event is part of Rohingya Response</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-12">
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Back to List
                    </a>
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="fas fa-save me-1"></i>Update Project
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function() {
            var initialSDGId = $('#sdgDropdown').val();
            var initialProgramId = @(Model.SDGProgramId ?? 0);
            
            // Load programs on page load if SDG is already selected
            if (initialSDGId) {
                loadPrograms(initialSDGId, initialProgramId);
            }
            
            // Cascading dropdown: Load programs when SDG is changed
            $('#sdgDropdown').change(function() {
                var sdgId = $(this).val();
                loadPrograms(sdgId, null);
            });
        });
        
        function loadPrograms(sdgId, selectedProgramId) {
            var programDropdown = $('#programDropdown');
            
            // Clear and disable program dropdown
            programDropdown.empty();
            programDropdown.append('<option value="">-- Loading... --</option>');
            programDropdown.prop('disabled', true);
            
            if (sdgId) {
                // Fetch programs for selected SDG
                $.ajax({
                    url: '/Admin/SDGProjects/GetProgramsBySDG',
                    type: 'GET',
                    data: { sdgId: sdgId },
                    success: function(data) {
                        programDropdown.empty();
                        
                        if (data.length > 0) {
                            programDropdown.append('<option value="">-- Select Program --</option>');
                            $.each(data, function(index, program) {
                                var option = $('<option></option>')
                                    .val(program.value)
                                    .text(program.text);
                                
                                // Pre-select if this is the initial load
                                if (selectedProgramId && program.value == selectedProgramId) {
                                    option.prop('selected', true);
                                }
                                
                                programDropdown.append(option);
                            });
                        } else {
                            programDropdown.append('<option value="">-- No Programs Available --</option>');
                        }
                        
                        programDropdown.prop('disabled', false);
                    },
                    error: function() {
                        programDropdown.empty();
                        programDropdown.append('<option value="">-- Error Loading Programs --</option>');
                        programDropdown.prop('disabled', false);
                    }
                });
            } else {
                programDropdown.empty();
                programDropdown.append('<option value="">-- First Select SDG --</option>');
                programDropdown.prop('disabled', false);
            }
        }
        
        function deleteImage(imageId) {
            if (confirm('Are you sure you want to delete this image?')) {
                fetch('/Admin/SDGProjects/DeleteImage', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(imageId)
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Failed to delete image');
                    }
                });
            }
        }
    </script>
}
