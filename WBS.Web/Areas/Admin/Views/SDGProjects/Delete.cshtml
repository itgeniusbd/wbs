@model WBS.Web.Models.SDGProject
@{
    ViewData["Title"] = "Delete SDG Project";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row mb-3">
        <div class="col-12">
            <h2 class="text-danger">
                <i class="fas fa-trash me-2"></i>Delete SDG Project
            </h2>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i>Confirm Deletion
                    </h5>
                </div>
                <div class="card-body">
                    <p class="lead">Are you sure you want to delete this project?</p>

                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        <strong>Warning:</strong> This action cannot be undone. All project data and images will be permanently deleted.
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            @if (!string.IsNullOrEmpty(Model.FeaturedImage))
                            {
                                <img src="@Model.FeaturedImage" alt="@Model.Title" class="img-fluid rounded" />
                            }
                            else
                            {
                                <div class="bg-light d-flex align-items-center justify-content-center rounded" style="height: 200px;">
                                    <i class="fas fa-image fa-3x text-muted"></i>
                                </div>
                            }
                        </div>
                        <div class="col-md-8">
                            <dl class="row">
                                <dt class="col-sm-4">SDG</dt>
                                <dd class="col-sm-8">
                                    @if (Model.SDG != null)
                                    {
                                        <span class="badge" style="background-color: @Model.SDG.Color; font-size: 1rem;">
                                            SDG @Model.SDG.Number - @Model.SDG.Name
                                        </span>
                                    }
                                </dd>

                                <dt class="col-sm-4">Title (EN)</dt>
                                <dd class="col-sm-8">@Model.Title</dd>

                                <dt class="col-sm-4">Title (BN)</dt>
                                <dd class="col-sm-8">@Model.TitleBn</dd>

                                <dt class="col-sm-4">Location</dt>
                                <dd class="col-sm-8">
                                    @if (!string.IsNullOrEmpty(Model.District))
                                    {
                                        <span class="badge bg-light text-dark">@Model.District</span>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.Thana))
                                    {
                                        <span class="badge bg-light text-dark">@Model.Thana</span>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.Union))
                                    {
                                        <span class="badge bg-light text-dark">@Model.Union</span>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.Village))
                                    {
                                        <span class="badge bg-light text-dark">@Model.Village</span>
                                    }
                                </dd>

                                <dt class="col-sm-4">Beneficiaries</dt>
                                <dd class="col-sm-8">
                                    <strong class="text-primary fs-5">@Model.BeneficiaryCount.ToString("N0")</strong>
                                </dd>

                                <dt class="col-sm-4">Gallery Images</dt>
                                <dd class="col-sm-8">
                                    @if (Model.Images.Any())
                                    {
                                        <span class="badge bg-info">@Model.Images.Count image(s)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No gallery images</span>
                                    }
                                </dd>

                                <dt class="col-sm-4">Status</dt>
                                <dd class="col-sm-8">
                                    @if (Model.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                    @if (Model.IsFeatured)
                                    {
                                        <span class="badge bg-warning">Featured</span>
                                    }
                                </dd>
                            </dl>
                        </div>
                    </div>

                    @if (Model.Images.Any())
                    {
                        <div class="mb-3">
                            <h6>Gallery Images (will be deleted):</h6>
                            <div class="row g-2">
                                @foreach (var image in Model.Images.OrderBy(i => i.DisplayOrder).Take(6))
                                {
                                    <div class="col-md-2">
                                        <img src="@image.ImageUrl" class="img-thumbnail" style="width: 100%; height: 100px; object-fit: cover;" />
                                    </div>
                                }
                                @if (Model.Images.Count > 6)
                                {
                                    <div class="col-md-2">
                                        <div class="bg-light d-flex align-items-center justify-content-center rounded" style="height: 100px;">
                                            <span class="text-muted">+@(Model.Images.Count - 6) more</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary btn-lg">
                                <i class="fas fa-arrow-left me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-danger btn-lg">
                                <i class="fas fa-trash me-1"></i>Delete Project
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
