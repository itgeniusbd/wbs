@model WBS.Web.Models.ProgramExpense

@{
    ViewData["Title"] = "Edit Program Expense";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-edit me-2"></i>Edit Program Expense</h2>
    <a href="@Url.Action("Index")" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back to List
    </a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.HiddenFor(m => m.Id)
            @Html.AntiForgeryToken()

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">SDG <span class="text-danger">*</span></label>
                    <select asp-for="SDGId" id="sdgSelect" class="form-select" required>
                        <option value="">Select SDG</option>
                        @foreach (var sdg in (List<WBS.Web.Models.SDG>)ViewBag.SDGs)
                        {
                            <option value="@sdg.Id" selected="@(Model.SDGId == sdg.Id)">@sdg.Name</option>
                        }
                    </select>
                    <span asp-validation-for="SDGId" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Program <span class="text-danger">*</span></label>
                    <select asp-for="ProgramId" id="programSelect" class="form-select" required>
                        <option value="">Select Program</option>
                        @foreach (var program in (List<WBS.Web.Models.SDGProgram>)ViewBag.Programs)
                        {
                            <option value="@program.Id" selected="@(Model.ProgramId == program.Id)">@program.Title</option>
                        }
                    </select>
                    <span asp-validation-for="ProgramId" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Project Event (Optional)</label>
                    <select asp-for="ProjectId" id="projectSelect" class="form-select">
                        <option value="">Select Project Event</option>
                        @foreach (var project in (List<WBS.Web.Models.SDGProject>)ViewBag.Projects)
                        {
                            <option value="@project.Id" selected="@(Model.ProjectId == project.Id)">@project.Title</option>
                        }
                    </select>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Amount (?) <span class="text-danger">*</span></label>
                    <input asp-for="Amount" type="number" class="form-control" step="0.01" min="0.01" required />
                    <span asp-validation-for="Amount" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Expense Date <span class="text-danger">*</span></label>
                    <input asp-for="ExpenseDate" type="date" class="form-control" required />
                    <span asp-validation-for="ExpenseDate" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Account <span class="text-danger">*</span></label>
                    <select asp-for="AccountId" class="form-select" required>
                        <option value="">Select Account</option>
                        @foreach (var account in (List<WBS.Web.Models.Account>)ViewBag.Accounts)
                        {
                            <option value="@account.Id" selected="@(Model.AccountId == account.Id)">
                                @account.AccountName (Balance: Tk @account.AccountBalance.ToString("N2"))
                            </option>
                        }
                    </select>
                    <span asp-validation-for="AccountId" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Details <span class="text-danger">*</span></label>
                <textarea asp-for="Details" class="form-control" rows="4" required></textarea>
                <span asp-validation-for="Details" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2"></i>Update
                </button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">
                    <i class="fas fa-times me-2"></i>Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Load programs when SDG is selected
        $('#sdgSelect').change(function() {
            const sdgId = $(this).val();
            const programSelect = $('#programSelect');
            const projectSelect = $('#projectSelect');
            
            programSelect.prop('disabled', true).html('<option value="">Loading...</option>');
            projectSelect.prop('disabled', true).html('<option value="">Select Project Event</option>');
            
            if (sdgId) {
                $.get('@Url.Action("GetProgramsBySDG")', { sdgId: sdgId }, function(programs) {
                    programSelect.html('<option value="">Select Program</option>');
                    programs.forEach(function(program) {
                        programSelect.append(`<option value="${program.id}">${program.title}</option>`);
                    });
                    programSelect.prop('disabled', false);
                });
            } else {
                programSelect.html('<option value="">Select Program</option>');
            }
        });

        // Load projects when program is selected
        $('#programSelect').change(function() {
            const programId = $(this).val();
            const projectSelect = $('#projectSelect');
            
            projectSelect.prop('disabled', true).html('<option value="">Loading...</option>');
            
            if (programId) {
                $.get('@Url.Action("GetProjectsByProgram")', { programId: programId }, function(projects) {
                    projectSelect.html('<option value="">Select Project Event (Optional)</option>');
                    projects.forEach(function(project) {
                        projectSelect.append(`<option value="${project.id}">${project.title}</option>`);
                    });
                    projectSelect.prop('disabled', false);
                });
            } else {
                projectSelect.html('<option value="">Select Project Event</option>');
            }
        });
    </script>
}
