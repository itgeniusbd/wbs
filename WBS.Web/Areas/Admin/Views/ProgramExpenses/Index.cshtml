@model IEnumerable<WBS.Web.Models.ProgramExpense>

@{
    ViewData["Title"] = "Program Expenses";
    var totalExpense = ViewBag.TotalExpense ?? 0m;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-money-bill-wave me-2"></i>Program Expenses</h2>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addExpenseModal">
        <i class="fas fa-plus me-2"></i>Add Expense
    </button>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filter Card -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">SDG</label>
                <select name="sdgId" class="form-select">
                    <option value="">All SDGs</option>
                    @foreach (var sdg in (List<WBS.Web.Models.SDG>)ViewBag.SDGs)
                    {
                        <option value="@sdg.Id" selected="@(ViewBag.SelectedSdgId == sdg.Id)">@sdg.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Program</label>
                <select name="programId" class="form-select">
                    <option value="">All Programs</option>
                    @foreach (var program in (List<WBS.Web.Models.SDGProgram>)ViewBag.Programs)
                    {
                        <option value="@program.Id" selected="@(ViewBag.SelectedProgramId == program.Id)">@program.Title</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Project Event</label>
                <select name="projectId" class="form-select">
                    <option value="">All Projects</option>
                    @foreach (var project in (List<WBS.Web.Models.SDGProject>)ViewBag.Projects)
                    {
                        <option value="@project.Id" selected="@(ViewBag.SelectedProjectId == project.Id)">@project.Title</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">From Date</label>
                <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2">
                <label class="form-label">To Date</label>
                <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-filter me-2"></i>Filter
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Summary Card -->
<div class="card mb-4 border-danger">
    <div class="card-body text-center">
        <h3 class="mb-0">Total Expense: <span class="text-danger">Tk @totalExpense.ToString("N2")</span></h3>
    </div>
</div>

<!-- Expenses Table -->
<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>SDG</th>
                        <th>Program</th>
                        <th>Project Event</th>
                        <th>Amount</th>
                        <th>Account</th>
                        <th>Details</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var expense in Model)
                        {
                            <tr>
                                <td>@expense.ExpenseDate.ToString("MMM dd, yyyy")</td>
                                <td>@expense.SDG?.Name</td>
                                <td>@expense.Program?.Title</td>
                                <td>@(expense.Project?.Title ?? "N/A")</td>
                                <td class="text-danger fw-bold">Tk @expense.Amount.ToString("N2")</td>
                                <td>@expense.Account?.AccountName</td>
                                <td>@expense.Details</td>
                                <td>
                                    <a href="@Url.Action("Edit", new { id = expense.Id })" class="btn btn-sm btn-warning">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-danger" onclick="deleteExpense(@expense.Id)">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                <i class="fas fa-inbox fa-3x mb-3 d-block"></i>
                                No program expenses found
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Expense Modal -->
<div class="modal fade" id="addExpenseModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Add Program Expense</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">SDG <span class="text-danger">*</span></label>
                        <select name="SDGId" id="sdgSelect" class="form-select" required>
                            <option value="">Select SDG</option>
                            @foreach (var sdg in (List<WBS.Web.Models.SDG>)ViewBag.SDGs)
                            {
                                <option value="@sdg.Id">@sdg.Name</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Program <span class="text-danger">*</span></label>
                        <select name="ProgramId" id="programSelect" class="form-select" required disabled>
                            <option value="">Select Program</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Project Event (Optional)</label>
                        <select name="ProjectId" id="projectSelect" class="form-select" disabled>
                            <option value="">Select Project Event</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Amount (?) <span class="text-danger">*</span></label>
                        <input type="number" name="Amount" class="form-control" step="0.01" min="0.01" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Expense Date <span class="text-danger">*</span></label>
                        <input type="date" name="ExpenseDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Details <span class="text-danger">*</span></label>
                        <textarea name="Details" class="form-control" rows="3" required></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Account <span class="text-danger">*</span></label>
                        <select name="AccountId" class="form-select" required>
                            <option value="">Select Account</option>
                            @foreach (var account in (List<WBS.Web.Models.Account>)ViewBag.Accounts)
                            {
                                <option value="@account.Id">@account.AccountName (Balance: Tk @account.AccountBalance.ToString("N2"))</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Load programs when SDG is selected
        $('#sdgSelect').change(function() {
            const sdgId = $(this).val();
            const programSelect = $('#programSelect');
            const projectSelect = $('#projectSelect');
            
            programSelect.prop('disabled', true).html('<option value="">Loading...</option>');
            projectSelect.prop('disabled', true).html('<option value="">Select Project Event</option>');
            
            if (sdgId) {
                $.get('@Url.Action("GetProgramsBySDG")', { sdgId: sdgId }, function(programs) {
                    programSelect.html('<option value="">Select Program</option>');
                    programs.forEach(function(program) {
                        programSelect.append(`<option value="${program.id}">${program.title}</option>`);
                    });
                    programSelect.prop('disabled', false);
                });
            } else {
                programSelect.html('<option value="">Select Program</option>');
            }
        });

        // Load projects when program is selected
        $('#programSelect').change(function() {
            const programId = $(this).val();
            const projectSelect = $('#projectSelect');
            
            projectSelect.prop('disabled', true).html('<option value="">Loading...</option>');
            
            if (programId) {
                $.get('@Url.Action("GetProjectsByProgram")', { programId: programId }, function(projects) {
                    projectSelect.html('<option value="">Select Project Event (Optional)</option>');
                    projects.forEach(function(project) {
                        projectSelect.append(`<option value="${project.id}">${project.title}</option>`);
                    });
                    projectSelect.prop('disabled', false);
                });
            } else {
                projectSelect.html('<option value="">Select Project Event</option>');
            }
        });

        // Delete expense
        function deleteExpense(id) {
            if (confirm('Are you sure you want to delete this program expense?')) {
                $.post('@Url.Action("Delete")', {
                    id: id,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                }, function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert(response.message);
                    }
                });
            }
        }
    </script>
}
