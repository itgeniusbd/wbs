@model IEnumerable<WBS.Web.Models.ContactMessage>
@{
    ViewData["Title"] = "Contact Messages";
    var filter = ViewBag.Filter as string ?? "all";
    var unreadCount = ViewBag.UnreadCount;
    var totalCount = ViewBag.TotalCount;
    var repliedCount = ViewBag.RepliedCount;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0"><i class="fas fa-envelope me-2"></i>Contact Messages</h1>
        <p class="text-muted mb-0">Manage incoming messages from website visitors</p>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1">Total Messages</p>
                        <h4 class="mb-0">@totalCount</h4>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded">
                        <i class="fas fa-envelope fa-2x text-primary"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1">Unread</p>
                        <h4 class="mb-0 text-warning">@unreadCount</h4>
                    </div>
                    <div class="bg-warning bg-opacity-10 p-3 rounded">
                        <i class="fas fa-envelope-open fa-2x text-warning"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1">Replied</p>
                        <h4 class="mb-0 text-success">@repliedCount</h4>
                    </div>
                    <div class="bg-success bg-opacity-10 p-3 rounded">
                        <i class="fas fa-reply fa-2x text-success"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1">Pending Reply</p>
                        <h4 class="mb-0 text-danger">@(totalCount - repliedCount)</h4>
                    </div>
                    <div class="bg-danger bg-opacity-10 p-3 rounded">
                        <i class="fas fa-clock fa-2x text-danger"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Tabs -->
<ul class="nav nav-tabs mb-4">
    <li class="nav-item">
        <a class="nav-link @(filter == "all" ? "active" : "")" href="@Url.Action("Index", new { filter = "all" })">
            <i class="fas fa-inbox me-2"></i>All (@totalCount)
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(filter == "unread" ? "active" : "")" href="@Url.Action("Index", new { filter = "unread" })">
            <i class="fas fa-envelope me-2"></i>Unread (@unreadCount)
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(filter == "unreplied" ? "active" : "")" href="@Url.Action("Index", new { filter = "unreplied" })">
            <i class="fas fa-clock me-2"></i>Pending Reply (@(totalCount - repliedCount))
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(filter == "replied" ? "active" : "")" href="@Url.Action("Index", new { filter = "replied" })">
            <i class="fas fa-check-circle me-2"></i>Replied (@repliedCount)
        </a>
    </li>
</ul>

<!-- Messages List -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <form method="post" id="bulkDeleteForm">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th width="40">
                                    <input type="checkbox" id="selectAll" class="form-check-input">
                                </th>
                                <th width="60">Status</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Subject</th>
                                <th>Date</th>
                                <th width="100">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var message in Model)
                            {
                                <tr class="@(!message.IsRead ? "table-warning" : "")">
                                    <td>
                                        <input type="checkbox" name="selectedIds" value="@message.Id" class="form-check-input message-checkbox">
                                    </td>
                                    <td>
                                        @if (!message.IsRead)
                                        {
                                            <span class="badge bg-warning text-dark" title="Unread">
                                                <i class="fas fa-envelope"></i>
                                            </span>
                                        }
                                        else if (message.IsReplied)
                                        {
                                            <span class="badge bg-success" title="Replied">
                                                <i class="fas fa-reply"></i>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary" title="Read">
                                                <i class="fas fa-envelope-open"></i>
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Details", new { id = message.Id })" class="text-decoration-none">
                                            <strong class="@(!message.IsRead ? "fw-bold" : "")">@message.Name</strong>
                                        </a>
                                        @if (!string.IsNullOrEmpty(message.Phone))
                                        {
                                            <br><small class="text-muted"><i class="fas fa-phone me-1"></i>@message.Phone</small>
                                        }
                                    </td>
                                    <td>
                                        <a href="mailto:@message.Email" class="text-decoration-none">
                                            @message.Email
                                        </a>
                                    </td>
                                    <td>
                                        <div class="text-truncate" style="max-width: 300px;">
                                            @(string.IsNullOrEmpty(message.Subject) ? message.Message : message.Subject)
                                        </div>
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            <i class="far fa-clock me-1"></i>
                                            @message.CreatedAt.ToString("MMM dd, yyyy")
                                            <br>@message.CreatedAt.ToString("hh:mm tt")
                                        </small>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a href="@Url.Action("Details", new { id = message.Id })" 
                                               class="btn btn-outline-primary" 
                                               title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <button type="button" 
                                                    class="btn btn-outline-danger" 
                                                    onclick="deleteMessage(@message.Id)"
                                                    title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                
                <!-- Bulk Actions -->
                <div class="p-3 border-top d-none" id="bulkActionsBar">
                    <div class="d-flex justify-content-between align-items-center">
                        <span id="selectedCount">0 messages selected</span>
                        <button type="submit" 
                                class="btn btn-danger btn-sm" 
                                formaction="@Url.Action("DeleteSelected")"
                                onclick="return confirm('Are you sure you want to delete selected messages?')">
                            <i class="fas fa-trash me-2"></i>Delete Selected
                        </button>
                    </div>
                </div>
                @Html.AntiForgeryToken()
            </form>
        }
        else
        {
            <div class="text-center py-5">
                <i class="far fa-envelope fa-4x text-muted mb-3"></i>
                <h5 class="text-muted">No messages found</h5>
                <p class="text-muted">
                    @if (filter == "unread")
                    {
                        <text>All messages have been read!</text>
                    }
                    else if (filter == "unreplied")
                    {
                        <text>All messages have been replied to!</text>
                    }
                    else
                    {
                        <text>No contact messages yet.</text>
                    }
                </p>
            </div>
        }
    </div>
</div>

<!-- Delete Form (hidden) -->
<form id="deleteForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        // Select All Checkbox
        document.getElementById('selectAll')?.addEventListener('change', function() {
            const checkboxes = document.querySelectorAll('.message-checkbox');
            checkboxes.forEach(cb => cb.checked = this.checked);
            updateBulkActions();
        });

        // Individual Checkboxes
        document.querySelectorAll('.message-checkbox').forEach(checkbox => {
            checkbox.addEventListener('change', updateBulkActions);
        });

        function updateBulkActions() {
            const selected = document.querySelectorAll('.message-checkbox:checked');
            const bulkBar = document.getElementById('bulkActionsBar');
            const countSpan = document.getElementById('selectedCount');
            
            if (selected.length > 0) {
                bulkBar.classList.remove('d-none');
                countSpan.textContent = `${selected.length} message(s) selected`;
            } else {
                bulkBar.classList.add('d-none');
            }
        }

        // Delete Single Message
        function deleteMessage(id) {
            if (confirm('Are you sure you want to delete this message?')) {
                const form = document.getElementById('deleteForm');
                form.action = '@Url.Action("Delete")/' + id;
                form.submit();
            }
        }
    </script>
}
