@model WBS.Web.Models.ContactMessage
@{
    ViewData["Title"] = "Message Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">?? Message Details</h1>
        <p class="text-muted mb-0">From @Model.Name</p>
    </div>
    <div>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Back to Messages
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <!-- Message Card -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-1">
                            @if (!string.IsNullOrEmpty(Model.Subject))
                            {
                                @Model.Subject
                            }
                            else
                            {
                                <text>No Subject</text>
                            }
                        </h5>
                        <div class="d-flex gap-2">
                            @if (!Model.IsRead)
                            {
                                <span class="badge bg-warning text-dark">Unread</span>
                            }
                            @if (Model.IsReplied)
                            {
                                <span class="badge bg-success">Replied</span>
                            }
                        </div>
                    </div>
                    <small class="text-muted">
                        <i class="far fa-clock me-1"></i>
                        @Model.CreatedAt.ToString("MMMM dd, yyyy 'at' hh:mm tt")
                    </small>
                </div>
            </div>
            <div class="card-body">
                <!-- Sender Info -->
                <div class="d-flex align-items-center mb-4 pb-4 border-bottom">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                        <i class="fas fa-user fa-lg text-primary"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h6 class="mb-1">@Model.Name</h6>
                        <div class="text-muted small">
                            <div><i class="fas fa-envelope me-2"></i><a href="mailto:@Model.Email">@Model.Email</a></div>
                            @if (!string.IsNullOrEmpty(Model.Phone))
                            {
                                <div><i class="fas fa-phone me-2"></i><a href="tel:@Model.Phone">@Model.Phone</a></div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Message Content -->
                <div class="message-content">
                    <h6 class="text-muted mb-3">Message:</h6>
                    <div class="p-3 bg-light rounded">
                        @Html.Raw(Model.Message.Replace("\n", "<br>"))
                    </div>
                </div>
            </div>
        </div>

        <!-- Reply Section -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h6 class="mb-0"><i class="fas fa-reply me-2"></i>Reply</h6>
            </div>
            <div class="card-body">
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    To reply to this message, please use your email client:
                    <a href="mailto:@Model.Email?subject=Re: @(Model.Subject ?? "Your Message")&body=Hi @Model.Name,%0D%0A%0D%0A" 
                       class="btn btn-primary btn-sm ms-2">
                        <i class="fas fa-envelope me-2"></i>Open Email Client
                    </a>
                </div>
                
                @if (!Model.IsReplied)
                {
                    <form method="post" asp-action="MarkAsReplied" asp-route-id="@Model.Id">
                        @Html.AntiForgeryToken()
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="markAsReplied" required>
                            <label class="form-check-label" for="markAsReplied">
                                I have replied to this message via email
                            </label>
                        </div>
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-check me-2"></i>Mark as Replied
                        </button>
                    </form>
                }
                else
                {
                    <div class="alert alert-success mb-0">
                        <i class="fas fa-check-circle me-2"></i>This message has been marked as replied.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
        <!-- Quick Actions -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white">
                <h6 class="mb-0"><i class="fas fa-bolt me-2"></i>Quick Actions</h6>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="mailto:@Model.Email" class="btn btn-primary">
                        <i class="fas fa-envelope me-2"></i>Send Email
                    </a>
                    
                    @if (!string.IsNullOrEmpty(Model.Phone))
                    {
                        <a href="tel:@Model.Phone" class="btn btn-success">
                            <i class="fas fa-phone me-2"></i>Call
                        </a>
                    }

                    @if (!Model.IsRead)
                    {
                        <form method="post" asp-action="MarkAsRead" asp-route-id="@Model.Id" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-warning w-100">
                                <i class="fas fa-envelope-open me-2"></i>Mark as Read
                            </button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-action="MarkAsUnread" asp-route-id="@Model.Id" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-warning w-100">
                                <i class="fas fa-envelope me-2"></i>Mark as Unread
                            </button>
                        </form>
                    }

                    <hr class="my-2">

                    <form method="post" asp-action="Delete" asp-route-id="@Model.Id" 
                          onsubmit="return confirm('Are you sure you want to delete this message?')">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger w-100">
                            <i class="fas fa-trash me-2"></i>Delete Message
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Message Info -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h6 class="mb-0"><i class="fas fa-info-circle me-2"></i>Message Info</h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <small class="text-muted d-block">Received:</small>
                    <strong>@Model.CreatedAt.ToString("MMMM dd, yyyy")</strong>
                    <div class="text-muted small">@Model.CreatedAt.ToString("hh:mm tt")</div>
                </div>

                <div class="mb-3">
                    <small class="text-muted d-block">Status:</small>
                    @if (Model.IsReplied)
                    {
                        <span class="badge bg-success">Replied</span>
                    }
                    else if (Model.IsRead)
                    {
                        <span class="badge bg-secondary">Read</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Unread</span>
                    }
                </div>

                <div class="mb-3">
                    <small class="text-muted d-block">Message ID:</small>
                    <code>#@Model.Id</code>
                </div>

                @if (!string.IsNullOrEmpty(Model.Subject))
                {
                    <div class="mb-3">
                        <small class="text-muted d-block">Subject:</small>
                        <strong>@Model.Subject</strong>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-focus on reply checkbox when opening email
        document.querySelector('a[href^="mailto"]')?.addEventListener('click', function() {
            setTimeout(() => {
                document.getElementById('markAsReplied')?.focus();
            }, 1000);
        });
    </script>
}
