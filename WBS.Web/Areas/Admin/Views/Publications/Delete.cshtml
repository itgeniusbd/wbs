@model WBS.Web.Models.Publication

@{
    ViewData["Title"] = "Delete Publication";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-danger">
        <i class="fas fa-trash me-2"></i>Delete Publication
    </h1>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back to List
    </a>
</div>

<div class="card shadow-sm border-danger">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0">
            <i class="fas fa-exclamation-triangle me-2"></i>Confirm Deletion
        </h5>
    </div>
    <div class="card-body">
        <div class="alert alert-warning">
            <strong>Warning!</strong> Are you sure you want to delete this publication? This action cannot be undone.
        </div>

        <div class="row">
            @if (!string.IsNullOrEmpty(Model.CoverImage))
            {
                <div class="col-md-4 mb-3">
                    <img src="@Model.CoverImage" alt="@Model.Title" class="img-fluid rounded" />
                </div>
            }
            <div class="@(string.IsNullOrEmpty(Model.CoverImage) ? "col-md-12" : "col-md-8")">
                <dl class="row">
                    <dt class="col-sm-3">Title:</dt>
                    <dd class="col-sm-9">@Model.Title</dd>

                    @if (!string.IsNullOrEmpty(Model.TitleBn))
                    {
                        <dt class="col-sm-3">Title (বাংলা):</dt>
                        <dd class="col-sm-9" style="font-family: 'Noto Sans Bengali', sans-serif;">@Model.TitleBn</dd>
                    }

                    @if (!string.IsNullOrEmpty(Model.Author))
                    {
                        <dt class="col-sm-3">Author:</dt>
                        <dd class="col-sm-9">@Model.Author</dd>
                    }

                    @if (!string.IsNullOrEmpty(Model.Publisher))
                    {
                        <dt class="col-sm-3">Publisher:</dt>
                        <dd class="col-sm-9">@Model.Publisher</dd>
                    }

                    @if (Model.PublishedDate.HasValue)
                    {
                        <dt class="col-sm-3">Published Date:</dt>
                        <dd class="col-sm-9">@Model.PublishedDate.Value.ToString("dd MMM yyyy")</dd>
                    }

                    <dt class="col-sm-3">Status:</dt>
                    <dd class="col-sm-9">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <form asp-action="Delete" method="post" class="mt-4">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-trash me-2"></i>Yes, Delete Publication
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-times me-2"></i>Cancel
            </a>
        </form>
    </div>
</div>
