@model WBS.Web.Models.Policy

@{
    ViewData["Title"] = "Delete Policy";
}

<div class="mb-4">
    <h2>Delete Policy</h2>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Policies</a></li>
            <li class="breadcrumb-item active">Delete</li>
        </ol>
    </nav>
</div>

<div class="card border-danger">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Confirm Deletion</h5>
    </div>
    <div class="card-body">
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-circle me-2"></i>
            Are you sure you want to delete this policy? This action cannot be undone.
        </div>

        <dl class="row">
            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">
                @Model.Title
                @if (!string.IsNullOrEmpty(Model.TitleBn))
                {
                    <br /><small class="text-muted bangla-text">@Model.TitleBn</small>
                }
            </dd>

            <dt class="col-sm-3">Icon</dt>
            <dd class="col-sm-9"><i class="@Model.Icon"></i> @Model.Icon</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">
                @Model.Description
                @if (!string.IsNullOrEmpty(Model.DescriptionBn))
                {
                    <br /><small class="text-muted bangla-text">@Model.DescriptionBn</small>
                }
            </dd>

            <dt class="col-sm-3">PDF</dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrEmpty(Model.PdfUrl))
                {
                    <a href="@Model.PdfUrl" target="_blank" class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-file-pdf me-1"></i>View PDF
                    </a>
                }
                else
                {
                    <span class="text-muted">No PDF</span>
                }
            </dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactive</span>
                }
            </dd>

            <dt class="col-sm-3">Created At</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash me-2"></i>Delete
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-times me-2"></i>Cancel
                </a>
            </div>
        </form>
    </div>
</div>
