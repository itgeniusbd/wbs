@model WBS.Web.Models.Policy

@{
    ViewData["Title"] = "Edit Policy";
}

<div class="mb-4">
    <h2>Edit Policy</h2>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Policies</a></li>
            <li class="breadcrumb-item active">Edit</li>
        </ol>
    </nav>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Title" class="form-label">Title (English)</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="TitleBn" class="form-label">Title (Bengali)</label>
                    <input asp-for="TitleBn" class="form-control bangla-text" style="font-family: 'Noto Sans Bengali', sans-serif;" />
                    <span asp-validation-for="TitleBn" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Icon" class="form-label">Icon Class (Font Awesome)</label>
                    <input asp-for="Icon" class="form-control" placeholder="e.g., fas fa-shield-alt" />
                    <small class="text-muted">Visit <a href="https://fontawesome.com/icons" target="_blank">Font Awesome</a> for icon classes</small>
                    <span asp-validation-for="Icon" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="DisplayOrder" class="form-label">Display Order</label>
                    <input asp-for="DisplayOrder" class="form-control" type="number" />
                    <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Description (English)</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DescriptionBn" class="form-label">Description (Bengali)</label>
                <textarea asp-for="DescriptionBn" class="form-control bangla-text" rows="3" style="font-family: 'Noto Sans Bengali', sans-serif;"></textarea>
                <span asp-validation-for="DescriptionBn" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">PDF Document</label>
                @if (!string.IsNullOrEmpty(Model.PdfUrl))
                {
                    <div class="mb-2">
                        <a href="@Model.PdfUrl" target="_blank" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-file-pdf me-1"></i>View Current PDF
                        </a>
                    </div>
                }
                <input type="file" name="pdfFile" class="form-control" accept=".pdf" />
                <small class="text-muted">Upload a new PDF to replace the existing one (optional)</small>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                <label asp-for="IsActive" class="form-check-label">Active</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2"></i>Update
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-times me-2"></i>Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
