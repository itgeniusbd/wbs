@model WBS.Web.Models.LegalStatus

@{
    ViewData["Title"] = "Legal Status Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="fas fa-certificate me-2"></i>Legal Status Management
    </h1>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Certificate Images Section -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="fas fa-image me-2"></i>NGO Certificate Images</h5>
    </div>
    <div class="card-body">
        <form asp-action="UpdateCertificate" method="post" enctype="multipart/form-data">
            <div class="row">
                <!-- English Certificate -->
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Certificate Image (English)</label>
                    @if (!string.IsNullOrEmpty(Model.CertificateImage))
                    {
                        <div class="mb-3">
                            <img src="@Model.CertificateImage" alt="Certificate" class="img-fluid border rounded" style="max-height: 400px;" />
                        </div>
                    }
                    <input type="file" name="certificateImage" class="form-control" accept="image/*" />
                    <small class="text-muted">Upload NGO registration certificate image</small>
                </div>

                <!-- Bangla Certificate -->
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Certificate Image (বাংলা)</label>
                    @if (!string.IsNullOrEmpty(Model.CertificateImageBn))
                    {
                        <div class="mb-3">
                            <img src="@Model.CertificateImageBn" alt="সনদ" class="img-fluid border rounded" style="max-height: 400px;" />
                        </div>
                    }
                    <input type="file" name="certificateImageBn" class="form-control" accept="image/*" />
                    <small class="text-muted">এনজিও নিবন্ধন সনদ ছবি আপলোড করুন</small>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save me-2"></i>Update Certificate Images
            </button>
        </form>
    </div>
</div>

<!-- Registration Information Section -->
<div class="card shadow-sm">
    <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-list me-2"></i>Registration Information</h5>
        <a asp-action="CreateRegistration" class="btn btn-light btn-sm">
            <i class="fas fa-plus me-1"></i>Add New
        </a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>SL No</th>
                        <th>Registration Authority</th>
                        <th>Registration Number</th>
                        <th>Date</th>
                        <th>Order</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RegistrationInfos != null && Model.RegistrationInfos.Any())
                    {
                        int slNo = 1;
                        foreach (var item in Model.RegistrationInfos.OrderBy(r => r.DisplayOrder))
                        {
                            <tr>
                                <td>@slNo</td>
                                <td>
                                    <strong>@item.Authority</strong>
                                    @if (!string.IsNullOrEmpty(item.AuthorityBn))
                                    {
                                        <br /><small class="text-muted">@item.AuthorityBn</small>
                                    }
                                </td>
                                <td>
                                    @item.RegistrationNumber
                                    @if (!string.IsNullOrEmpty(item.RegistrationNumberBn))
                                    {
                                        <br /><small class="text-muted">@item.RegistrationNumberBn</small>
                                    }
                                </td>
                                <td>@item.RegistrationDate.ToString("dd.MM.yyyy")</td>
                                <td>
                                    <span class="badge bg-secondary">@item.DisplayOrder</span>
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="EditRegistration" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger" onclick="confirmDelete(@item.Id)" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            slNo++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4">
                                <i class="fas fa-inbox fa-3x text-muted mb-3 d-block"></i>
                                <p class="text-muted mb-0">No registration information added yet.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete Form (Hidden) -->
<form id="deleteForm" asp-action="DeleteRegistration" method="post" style="display: none;">
    @Html.AntiForgeryToken()
    <input type="hidden" id="deleteId" name="id" />
</form>

@section Scripts {
    <script>
        function confirmDelete(id) {
            if (confirm('Are you sure you want to delete this registration information?')) {
                document.getElementById('deleteId').value = id;
                document.getElementById('deleteForm').submit();
            }
        }
    </script>
}
